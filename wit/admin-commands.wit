    //   CLIENT UNBLOCK
    //   CLIENT UNPAUSE
    //   CLUSTER ADDSLOTS
    //   CLUSTER ADDSLOTSRANGE
    //   CLUSTER BUMPEPOCH
    //   CLUSTER CANCELSLOTMIGRATIONS
    //   CLUSTER COUNT-FAILURE-REPORTS
    //   CLUSTER DELSLOTS
    //   CLUSTER DELSLOTSRANGE
    //   CLUSTER FAILOVER
    //   CLUSTER FLUSHSLOT
    //   CLUSTER FLUSHSLOTS
    //   CLUSTER FORGET
    //   CLUSTER GETSLOTMIGRATIONS
    //   CLUSTER MEET
    //   CLUSTER MIGRATESLOTS
    //   CLUSTER REPLICAS
    //   CLUSTER REPLICATE
    //   CLUSTER RESET
    //   CLUSTER SAVECONFIG
    //   CLUSTER SET-CONFIG-EPOCH
    //   CLUSTER SETSLOT
    //   CLUSTER SLAVES
    //   CLUSTER SYNCSLOTS
    //   COMMANDLOG GET
    //   COMMANDLOG LEN
    //   COMMANDLOG RESET
    //   CONFIG GET
    //   CONFIG RESETSTAT
    //   CONFIG REWRITE
    //   CONFIG SET
    //   DEBUG
    //   FAILOVER
