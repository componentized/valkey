/// Administrative commands, Valkey's @admin ACL category.
///
/// Also holds the rest of the ACL family, e.g. ACL GENPASS, which is in no data type or
/// functional category.
interface admin-commands {
    use connection.{connection, error};

    acl-deluser: async func(connection: borrow<connection>, username: string) -> result<_, error>;
    acl-genpass: async func(connection: borrow<connection>) -> result<string, error>;
    acl-setuser: async func(connection: borrow<connection>, username: string, rules: list<string>) -> result<_, error>;

    // not yet implemented, from the @admin category:
    //   ACL CAT
    //   ACL DRYRUN
    //   ACL GETUSER
    //   ACL LIST
    //   ACL LOAD
    //   ACL LOG
    //   ACL SAVE
