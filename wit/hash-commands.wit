/// Commands for hash values, Valkey's @hash ACL category.
interface hash-commands {
    use wasi:clocks/system-clock@0.3.0.{duration, instant};
    use connection.{connection, error};

    // copied from keyspace-commands, so each command interface stands alone
    enum expire-mode {
        /// Set expiration only when the field has no expiration.
        nx,
        /// Set expiration only when the field has an existing expiration.
        xx,
        /// Set expiration only when the new expiration is greater than current one.
        gt,
        /// Set expiration only when the new expiration is less than current one.
        lt,
    }

    enum expire-result {
        /// -2: key does not exist, or field does not exist in the HASH.
        does-not-exist,
        /// 0: the specified NX | XX | GT | LT condition has not been met.
        condition-not-met,
        /// 1: the expiration time was applied.
        applied,
        /// 2: when called with 0 seconds.
        zero-seconds,
    }

    record hrandfield-opts {
        count: option<s64>,
        with-values: option<bool>,
    }

    record hscan-opts {
        match: option<string>,
        count: option<s64>,
        no-values: option<bool>,
    }

    hdel: async func(connection: borrow<connection>, key: string, field: string) -> result<_, error>;
    hexists: async func(connection: borrow<connection>, key: string, field: string) -> result<bool, error>;
    hexpire: async func(connection: borrow<connection>, key: string, seconds: duration, mode: option<expire-mode>, fields: list<string>) -> result<list<expire-result>, error>;
    hexpireat: async func(connection: borrow<connection>, key: string, seconds: instant, mode: option<expire-mode>, fields: list<string>) -> result<list<expire-result>, error>;
    hget: async func(connection: borrow<connection>, key: string, field: string) -> result<option<string>, error>;
    hgetall: async func(connection: borrow<connection>, key: string) -> result<list<tuple<string, string>>, error>;
    hincrby: async func(connection: borrow<connection>, key: string, field: string, increment: s64) -> result<s64, error>;
    hincrbyfloat: async func(connection: borrow<connection>, key: string, field: string, increment: f64) -> result<string, error>;
    hkeys: async func(connection: borrow<connection>, key: string) -> result<list<string>, error>;
    hlen: async func(connection: borrow<connection>, key: string) -> result<u64, error>;
    hmget: async func(connection: borrow<connection>, key: string, fields: list<string>) -> result<list<option<string>>, error>;
    hmset: async func(connection: borrow<connection>, key: string, fields: list<tuple<string, string>>) -> result<_, error>;
    hrandfield: async func(connection: borrow<connection>, key: string, opts: option<hrandfield-opts>) -> result<option<list<tuple<string, option<string>>>>, error>;
    hscan: async func(connection: borrow<connection>, key: string, cursor: option<string>, opts: option<hscan-opts>) -> result<tuple<option<string>, list<tuple<string, option<string>>>>, error>;
    hset: async func(connection: borrow<connection>, key: string, field: string, value: string) -> result<_, error>;
    hsetnx: async func(connection: borrow<connection>, key: string, field: string, value: string) -> result<bool, error>;
    hstrlen: async func(connection: borrow<connection>, key: string, field: string) -> result<u64, error>;
    hvals: async func(connection: borrow<connection>, key: string) -> result<list<string>, error>;

    // not yet implemented, from the @hash category:
    //   HEXPIRETIME
    //   HGETDEL
    //   HGETEX
    //   HPERSIST
    //   HPEXPIRE
    //   HPEXPIREAT
    //   HPEXPIRETIME
    //   HPTTL
    //   HSETEX
    //   HTTL
}
