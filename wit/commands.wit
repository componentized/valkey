    /// GEODIST key member1 member2 [ m | km | ft | mi ]
    /// https://valkey.io/commands/geodist/
    @since(version = 0.3.0-dev)
    geodist: async func(connection: borrow<connection>, key: string, member1: string-or-bytes, member2: string-or-bytes, unit: option<geo-unit>) -> result<option<double>, error-code>;

    /// Returns members from a geospatial index as geohash strings.
