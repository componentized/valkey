    ///
    /// CLIENT TRACKING 〈 ON | OFF 〉 [ PREFIX prefix [ PREFIX prefix ... ] ] [ BCAST ] [ OPTIN ] [ OPTOUT ] [ NOLOOP ]
    /// https://valkey.io/commands/client-tracking/
    @since(version = 0.3.0-dev)
    client-tracking: async func(connection: borrow<connection>, options: option<client-tracking-options>) -> result<_, error-code>;

    /// Returns information about server-assisted client-side caching for the connection.
    ///
    /// CLIENT TRACKINGINFO
    /// https://valkey.io/commands/client-trackinginfo/
    @since(version = 0.3.0-dev)
    client-trackinginfo: async func(connection: borrow<connection>) -> result<client-trackinginfo-reply, error-code>;

    /// Returns detailed information about all commands.
    ///
    /// COMMAND
    /// https://valkey.io/commands/command/
    @since(version = 0.3.0-dev)
    command: async func(connection: borrow<connection>) -> result<list<command-reply>, error-code>;

    /// Returns a count of commands.
    ///
    /// COMMAND COUNT
    /// https://valkey.io/commands/command-count/
    @since(version = 0.3.0-dev)
    command-count: async func(connection: borrow<connection>) -> result<integer, error-code>;

    /// Returns documentary information about one, multiple or all commands.
    ///
