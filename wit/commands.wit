/// Typed functions for Valkey's commands, over the mechanics of a connection.
///
/// Each function sends one command and converts its reply. The docs of a function cover what
/// differs from the raw command, see the linked Valkey docs for what the command does. Commands
/// that change the state of the connection itself are on the connection, e.g. SUBSCRIBE, MULTI and
/// EXEC, WATCH, RESET and HELLO.
///
/// The types are those of the `types` interface, used here under names that may change, e.g.
/// renamed to avoid clashing with a function for a new command. Refer to a type through `types`
/// for a name that does not change.
///
/// The functions follow these idioms:
///
/// - Arguments are in the order of the command's words.
/// - A list argument must have at least one item, as the command requires, an empty list fails with
///   a client error before anything is sent. A list the command allows to be left out is an
///   option, none rather than empty.
/// - An optional argument is an option, a flag is a bool, e.g. `replace` for `REPLACE`, and a
///   choice of keywords is an enum or a variant, e.g. `list-side` for `LEFT | RIGHT`.
/// - Durations and points in time are records named for their unit, e.g. `duration-seconds` and
///   `unix-time-milliseconds`.
/// - Keys, fields, patterns and names are `string`. Values, members and payloads are
///   `string-or-bytes`, a reply that is not UTF-8 is `bytes`. Values that are binary by nature, like
///   the serialized values of DUMP and RESTORE, are `bytes`. A reply where a `string` is expected
///   that is not UTF-8 fails with a client error.
/// - A null reply is none, e.g. GET of a key that does not exist.
/// - An integer reply that is `0` or `1` is a bool, e.g. whether HSETNX set the field.
/// - An integer reply with sentinel values is a variant or an enum with a case for each, e.g.
///   `ttl-reply` for TTL's `-2` and `-1`, or none when it stands for nothing, e.g. BITPOS's `-1`.
/// - A reply whose shape an option changes, e.g. with `WITHSCORES`, has a function of its own for
///   that form, e.g. `zrange-withscores`, its docs naming the other forms.
/// - A scan starts with the `start` cursor and resumes with the one it returned, none once it is
///   complete.
/// - An error reply fails with a `server` error. Arguments the client rejects, and replies it cannot
///   convert, fail with a `client` error.
/// - A command that blocks, e.g. BLPOP, or changes the state of the connection, e.g. SELECT,
///   affects every caller sharing the connection, see the command's docs.
interface commands {
    @since(version = 0.3.0-dev)
    use connection.{connection};
    @since(version = 0.3.0-dev)
    use types.{
        double, error-code, integer, resp-value, duration-seconds, duration-milliseconds,
        unix-time-seconds, unix-time-milliseconds, cursor, ttl-mode, hexpire-result,
        hpexpireat-result, hpexpire-result, hexpireat-result, ttl-reply, httl-reply, pttl-reply,
        hpttl-reply, expiretime-reply, hexpiretime-reply, pexpiretime-reply, hpexpiretime-reply,
        acl-dryrun-result, acl-log-entry, bgsave-operation, client-type, client-filter,
        client-pause-mode, client-unblock-type, cluster-bumpepoch-result, cluster-failover-mode,
        cluster-getslotmigrations-operation, cluster-getslotmigrations-entry,
        cluster-migrateslots-group, cluster-reset-mode, cluster-setslot-state, commandlog-type,
        commandlog-entry, slowlog-entry, failover-target, latency-histogram-entry,
        latency-latest-entry, module-list-entry, role-primary-replica, role-primary, role-replica,
        role-reply, shutdown-flags, shutdown-save, acl-list-entry, acl-rule, acl-selector-rule,
        acl-key-rule, acl-channel-rule, acl-command-rule, acl-db-rule, acl-user-rule, bit-range,
        bitfield-encoding, bitfield-offset, bitfield-overflow, bitfield-get, bitfield-ro-get,
        bitfield-set, bitfield-incrby, bitfield-operation, bitop-operation,
        command-key-spec-begin-search, command-key-spec-keyword, command-key-spec-find-keys,
        command-key-spec-range, command-key-spec-keynum, command-key-spec, command-info-reply,
        command-reply, command-docs-argument-type, command-docs-argument, command-docs-reply,
        client-setinfo-attr, client-tracking-mode, client-tracking-options,
        client-trackinginfo-redirect, client-trackinginfo-reply, command-list-filter,
        geo-coordinates, geo-unit, geoadd-condition, geosearch-from, geosearch-radius,
        geosearch-box, geosearch-shape, geosearchstore-shape, geosearch-count, geosearchstore-count,
        geosearch-with-flags, geosearch-with-result, hpersist-result, hsetex-condition,
        hsetex-field-condition, key-type, migrate-flags, migrate-auth, list-side, linsert-position,
        linsert-result, flush-mode, function-list-function, function-list-library,
        function-stats-running, function-stats-engine, function-stats-reply, limit, sort-opts,
        sort-ro-opts, sort-order, score-bound, lex-bound, zmpop-end, bzmpop-end, zset-aggregate,
        zrange-by, zrangestore-by, zrange-withscores-by, zadd-condition, zadd-comparison, stream-id,
        stream-trim, stream-trim-maxlen, stream-trim-minid, stream-trim-efficiency, xclaim-opts,
        xinfo-consumers-entry, xinfo-groups-entry, xinfo-stream-reply, xinfo-stream-reply-full,
        xinfo-stream-reply-full-group, xinfo-stream-reply-full-consumer, xpending-summary,
        xpending-extended-entry, getex-ttl, hgetex-ttl, lcs-idx-reply, lcs-idx-match,
        msetex-precondition, msetex-ttl, set-precondition, set-ttl, hsetex-ttl, bytes,
        string-or-bytes, restore-ttl, function-restore-policy
    };

    /// Lists the ACL categories, or the commands inside a category.
    ///
    /// ACL CAT [ category ]
    /// https://valkey.io/commands/acl-cat/
    @since(version = 0.3.0-dev)
    acl-cat: async func(connection: borrow<connection>, category: option<string>) -> result<list<string>, error-code>;

    /// Deletes ACL users, and terminates their connections.
    ///
    /// ACL DELUSER username [ username ... ]
    /// https://valkey.io/commands/acl-deluser/
    @since(version = 0.3.0-dev)
    acl-deluser: async func(connection: borrow<connection>, usernames: list<string>) -> result<integer, error-code>;

    /// Simulates the execution of a command by a user, without executing the command.
    ///
    /// ACL DRYRUN username command [ arg [ arg ... ] ]
    /// https://valkey.io/commands/acl-dryrun/
    @since(version = 0.3.0-dev)
    acl-dryrun: async func(connection: borrow<connection>, username: string, command: list<string>) -> result<acl-dryrun-result, error-code>;

    /// Generates a pseudorandom, secure password that can be used to identify ACL users.
    ///
    /// ACL GENPASS [ bits ]
    /// https://valkey.io/commands/acl-genpass/
    @since(version = 0.3.0-dev)
    acl-genpass: async func(connection: borrow<connection>, bits: option<integer>) -> result<string, error-code>;

    /// Lists the ACL rules of a user.
    ///
    /// None when the user does not exist. The rules are as the server normalized them, e.g.
    /// `allkeys` is `~*`. Applied with `acl-setuser`, after `reset`, they recreate the user.
    ///
    /// ACL GETUSER username
    /// https://valkey.io/commands/acl-getuser/
    @since(version = 0.3.0-dev)
    acl-getuser: async func(connection: borrow<connection>, username: string) -> result<option<list<acl-rule>>, error-code>;

    /// Dumps the effective rules in ACL file format.
    ///
    /// ACL LIST
    /// https://valkey.io/commands/acl-list/
    @since(version = 0.3.0-dev)
    acl-list: async func(connection: borrow<connection>) -> result<list<acl-list-entry>, error-code>;

    /// Reloads the rules from the configured ACL file.
    ///
    /// ACL LOAD
    /// https://valkey.io/commands/acl-load/
    @since(version = 0.3.0-dev)
    acl-load: async func(connection: borrow<connection>) -> result<_, error-code>;

    /// Lists recent security events generated due to ACL rules.
    ///
    /// See also `acl-log-reset`.
    ///
    /// ACL LOG [ count ]
    /// https://valkey.io/commands/acl-log/
    @since(version = 0.3.0-dev)
    acl-log: async func(connection: borrow<connection>, count: option<integer>) -> result<list<acl-log-entry>, error-code>;

    /// Lists recent security events generated due to ACL rules.
    ///
    /// The `RESET` form, clearing the security events.
    ///
    /// See also `acl-log`.
    ///
    /// ACL LOG RESET
    /// https://valkey.io/commands/acl-log/
    @since(version = 0.3.0-dev)
    acl-log-reset: async func(connection: borrow<connection>) -> result<_, error-code>;

    /// Saves the effective ACL rules in the configured ACL file.
    ///
    /// ACL SAVE
    /// https://valkey.io/commands/acl-save/
    @since(version = 0.3.0-dev)
    acl-save: async func(connection: borrow<connection>) -> result<_, error-code>;

    /// Creates and modifies an ACL user and its rules.
    ///
    /// ACL SETUSER username [ rule ] [ [ rule ] ... ]
    /// https://valkey.io/commands/acl-setuser/
    @since(version = 0.3.0-dev)
    acl-setuser: async func(connection: borrow<connection>, username: string, rules: option<list<acl-rule>>) -> result<_, error-code>;

    /// Lists all ACL users.
    ///
    /// ACL USERS
    /// https://valkey.io/commands/acl-users/
    @since(version = 0.3.0-dev)
    acl-users: async func(connection: borrow<connection>) -> result<list<string>, error-code>;

    /// Returns the authenticated username of the current connection.
    ///
    /// ACL WHOAMI
    /// https://valkey.io/commands/acl-whoami/
    @since(version = 0.3.0-dev)
    acl-whoami: async func(connection: borrow<connection>) -> result<string, error-code>;

    /// Asynchronously rewrites the append-only file to disk.
    ///
    /// BGREWRITEAOF
    /// https://valkey.io/commands/bgrewriteaof/
    @since(version = 0.3.0-dev)
    bgrewriteaof: async func(connection: borrow<connection>) -> result<string, error-code>;

    /// Asynchronously saves the database(s) to disk.
    ///
    /// BGSAVE [ SCHEDULE | CANCEL ]
    /// https://valkey.io/commands/bgsave/
    @since(version = 0.3.0-dev)
    bgsave: async func(connection: borrow<connection>, operation: option<bgsave-operation>) -> result<string, error-code>;

    /// Terminates open connections.
    ///
    /// CLIENT KILL filter [ filter ... ]
    /// https://valkey.io/commands/client-kill/
    @since(version = 0.3.0-dev)
    client-kill: async func(connection: borrow<connection>, filters: list<client-filter>) -> result<integer, error-code>;

    /// Lists open connections.
    ///
    /// Each connection is a map of its fields, parsed from the server's text, e.g. `id`, `addr` and
    /// `name`.
    ///
    /// CLIENT LIST [ filter [ filter ... ] ]
    /// https://valkey.io/commands/client-list/
    @since(version = 0.3.0-dev)
    client-list: async func(connection: borrow<connection>, filters: option<list<client-filter>>) -> result<list<map<string, string>>, error-code>;

    /// Sets the client eviction mode of the connection.
    ///
    /// It applies to the connection, so to every caller sharing it.
    ///
    /// CLIENT NO-EVICT 〈 ON | OFF 〉
    /// https://valkey.io/commands/client-no-evict/
    @since(version = 0.3.0-dev)
    client-no-evict: async func(connection: borrow<connection>, enabled: bool) -> result<_, error-code>;

    /// Suspends commands processing.
    ///
    /// CLIENT PAUSE timeout [ WRITE | ALL ]
    /// https://valkey.io/commands/client-pause/
    @since(version = 0.3.0-dev)
    client-pause: async func(connection: borrow<connection>, timeout: duration-milliseconds, mode: option<client-pause-mode>) -> result<_, error-code>;

    /// Unblocks a client blocked by a blocking command from a different connection.
    ///
    /// CLIENT UNBLOCK client-id [ TIMEOUT | ERROR ]
    /// https://valkey.io/commands/client-unblock/
    @since(version = 0.3.0-dev)
    client-unblock: async func(connection: borrow<connection>, client-id: integer, unblock-type: option<client-unblock-type>) -> result<bool, error-code>;

    /// Resumes processing commands from paused clients.
    ///
    /// CLIENT UNPAUSE
    /// https://valkey.io/commands/client-unpause/
    @since(version = 0.3.0-dev)
    client-unpause: async func(connection: borrow<connection>) -> result<_, error-code>;

    /// Assigns new hash slots to a node.
    ///
    /// CLUSTER ADDSLOTS slot [ slot ... ]
    /// https://valkey.io/commands/cluster-addslots/
    @since(version = 0.3.0-dev)
    cluster-addslots: async func(connection: borrow<connection>, slots: list<u16>) -> result<_, error-code>;

    /// Assigns new hash slot ranges to a node.
    ///
    /// CLUSTER ADDSLOTSRANGE start-slot end-slot [ start-slot end-slot ... ]
    /// https://valkey.io/commands/cluster-addslotsrange/
    @since(version = 0.3.0-dev)
    cluster-addslotsrange: async func(connection: borrow<connection>, ranges: list<tuple<u16, u16>>) -> result<_, error-code>;

    /// Advances the cluster config epoch.
    ///
    /// CLUSTER BUMPEPOCH
    /// https://valkey.io/commands/cluster-bumpepoch/
    @since(version = 0.3.0-dev)
    cluster-bumpepoch: async func(connection: borrow<connection>) -> result<cluster-bumpepoch-result, error-code>;

    /// Cancel all current ongoing slot migration operations.
    ///
    /// CLUSTER CANCELSLOTMIGRATIONS
    /// https://valkey.io/commands/cluster-cancelslotmigrations/
    @since(version = 0.3.0-dev)
    cluster-cancelslotmigrations: async func(connection: borrow<connection>) -> result<_, error-code>;

    /// Returns the number of active failure reports for a node.
    ///
    /// CLUSTER COUNT-FAILURE-REPORTS node-id
    /// https://valkey.io/commands/cluster-count-failure-reports/
    @since(version = 0.3.0-dev)
    cluster-count-failure-reports: async func(connection: borrow<connection>, node-id: string) -> result<integer, error-code>;

    /// Sets hash slots as unbound for a node.
    ///
    /// CLUSTER DELSLOTS slot [ slot ... ]
    /// https://valkey.io/commands/cluster-delslots/
    @since(version = 0.3.0-dev)
    cluster-delslots: async func(connection: borrow<connection>, slots: list<u16>) -> result<_, error-code>;

    /// Sets hash slot ranges as unbound for a node.
    ///
    /// CLUSTER DELSLOTSRANGE start-slot end-slot [ start-slot end-slot ... ]
    /// https://valkey.io/commands/cluster-delslotsrange/
    @since(version = 0.3.0-dev)
    cluster-delslotsrange: async func(connection: borrow<connection>, ranges: list<tuple<u16, u16>>) -> result<_, error-code>;

    /// Forces a replica to perform a manual failover of its primary.
    ///
    /// CLUSTER FAILOVER [ FORCE | TAKEOVER ]
    /// https://valkey.io/commands/cluster-failover/
    @since(version = 0.3.0-dev)
    cluster-failover: async func(connection: borrow<connection>, mode: option<cluster-failover-mode>) -> result<_, error-code>;

    /// Deletes all slots information from a node.
    ///
    /// CLUSTER FLUSHSLOTS
    /// https://valkey.io/commands/cluster-flushslots/
    @since(version = 0.3.0-dev)
    cluster-flushslots: async func(connection: borrow<connection>) -> result<_, error-code>;

    /// Removes a node from the nodes table.
    ///
    /// CLUSTER FORGET node-id
    /// https://valkey.io/commands/cluster-forget/
    @since(version = 0.3.0-dev)
    cluster-forget: async func(connection: borrow<connection>, node-id: string) -> result<_, error-code>;

    /// Gets the status of ongoing and recently finished slot import and export operations.
    ///
    /// CLUSTER GETSLOTMIGRATIONS
    /// https://valkey.io/commands/cluster-getslotmigrations/
    @since(version = 0.3.0-dev)
    cluster-getslotmigrations: async func(connection: borrow<connection>) -> result<list<cluster-getslotmigrations-entry>, error-code>;

    /// Forces a node to handshake with another node.
    ///
    /// CLUSTER MEET ip port [ cluster-bus-port ]
    /// https://valkey.io/commands/cluster-meet/
    @since(version = 0.3.0-dev)
    cluster-meet: async func(connection: borrow<connection>, ip: string, port: u16, cluster-bus-port: option<u16>) -> result<_, error-code>;

    /// Migrate the given slots from this node to the specified nodes.
    ///
    /// CLUSTER MIGRATESLOTS SLOTSRANGE start-slot end-slot [ start-slot end-slot ... ] NODE node-id [ AUTH username password ] [ SLOTSRANGE ... ]
    /// https://valkey.io/commands/cluster-migrateslots/
    @since(version = 0.3.0-dev)
    cluster-migrateslots: async func(connection: borrow<connection>, migrations: list<cluster-migrateslots-group>) -> result<_, error-code>;

    /// Lists the replica nodes of a primary node.
    ///
    /// CLUSTER REPLICAS node-id
    /// https://valkey.io/commands/cluster-replicas/
    @since(version = 0.3.0-dev)
    cluster-replicas: async func(connection: borrow<connection>, node-id: string) -> result<list<string>, error-code>;

    /// Configures a node as replica of a primary node or detaches a replica from its primary.
    ///
    /// None detaches the node from its primary, `NO ONE`.
    ///
    /// CLUSTER REPLICATE 〈 node-id | NO ONE 〉
    /// https://valkey.io/commands/cluster-replicate/
    @since(version = 0.3.0-dev)
    cluster-replicate: async func(connection: borrow<connection>, node-id: option<string>) -> result<_, error-code>;

    /// Resets a node.
    ///
    /// CLUSTER RESET [ HARD | SOFT ]
    /// https://valkey.io/commands/cluster-reset/
    @since(version = 0.3.0-dev)
    cluster-reset: async func(connection: borrow<connection>, mode: option<cluster-reset-mode>) -> result<_, error-code>;

    /// Forces a node to save the cluster configuration to disk.
    ///
    /// CLUSTER SAVECONFIG
    /// https://valkey.io/commands/cluster-saveconfig/
    @since(version = 0.3.0-dev)
    cluster-saveconfig: async func(connection: borrow<connection>) -> result<_, error-code>;

    /// Sets the configuration epoch for a new node.
    ///
    /// CLUSTER SET-CONFIG-EPOCH config-epoch
    /// https://valkey.io/commands/cluster-set-config-epoch/
    @since(version = 0.3.0-dev)
    cluster-set-config-epoch: async func(connection: borrow<connection>, config-epoch: integer) -> result<_, error-code>;

    /// Binds a hash slot to a node.
    ///
    /// CLUSTER SETSLOT slot 〈 IMPORTING node-id | MIGRATING node-id | NODE node-id | STABLE 〉 [ TIMEOUT timeout ]
    /// https://valkey.io/commands/cluster-setslot/
    @since(version = 0.3.0-dev)
    cluster-setslot: async func(connection: borrow<connection>, slot: u16, state: cluster-setslot-state, timeout: option<duration-milliseconds>) -> result<_, error-code>;

    /// Returns the specified command log's entries.
    ///
    /// COMMANDLOG GET count 〈 slow | large-request | large-reply 〉
    /// https://valkey.io/commands/commandlog-get/
    @since(version = 0.3.0-dev)
    commandlog-get: async func(connection: borrow<connection>, count: integer, %type: commandlog-type) -> result<list<commandlog-entry>, error-code>;

    /// Returns the number of entries in the specified type of command log.
    ///
    /// COMMANDLOG LEN 〈 slow | large-request | large-reply 〉
    /// https://valkey.io/commands/commandlog-len/
    @since(version = 0.3.0-dev)
    commandlog-len: async func(connection: borrow<connection>, %type: commandlog-type) -> result<integer, error-code>;

    /// Clears all entries from the specified type of command log.
    ///
    /// COMMANDLOG RESET 〈 slow | large-request | large-reply 〉
    /// https://valkey.io/commands/commandlog-reset/
    @since(version = 0.3.0-dev)
    commandlog-reset: async func(connection: borrow<connection>, %type: commandlog-type) -> result<_, error-code>;

    /// Returns the effective values of configuration parameters.
    ///
    /// CONFIG GET parameter [ parameter ... ]
    /// https://valkey.io/commands/config-get/
    @since(version = 0.3.0-dev)
    config-get: async func(connection: borrow<connection>, parameters: list<string>) -> result<map<string, string>, error-code>;

    /// Resets the server's statistics.
    ///
    /// CONFIG RESETSTAT
    /// https://valkey.io/commands/config-resetstat/
    @since(version = 0.3.0-dev)
    config-resetstat: async func(connection: borrow<connection>) -> result<_, error-code>;

    /// Persists the effective configuration to file.
    ///
    /// CONFIG REWRITE
    /// https://valkey.io/commands/config-rewrite/
    @since(version = 0.3.0-dev)
    config-rewrite: async func(connection: borrow<connection>) -> result<_, error-code>;

    /// Sets configuration parameters in-flight.
    ///
    /// CONFIG SET parameter value [ parameter value ... ]
    /// https://valkey.io/commands/config-set/
    @since(version = 0.3.0-dev)
    config-set: async func(connection: borrow<connection>, parameters-and-values: list<tuple<string, string>>) -> result<_, error-code>;

    /// Starts a coordinated failover from a server to one of its replicas.
    ///
    /// FAILOVER [ TO host port [ FORCE ] ] [ ABORT ] [ TIMEOUT milliseconds ]
    /// https://valkey.io/commands/failover/
    @since(version = 0.3.0-dev)
    failover: async func(connection: borrow<connection>, target: option<failover-target>, abort: bool, timeout: option<duration-milliseconds>) -> result<_, error-code>;

    /// Returns the Unix timestamp of the last successful save to disk.
    ///
    /// LASTSAVE
    /// https://valkey.io/commands/lastsave/
    @since(version = 0.3.0-dev)
    lastsave: async func(connection: borrow<connection>) -> result<unix-time-seconds, error-code>;

    /// Returns a human-readable latency analysis report.
    ///
    /// LATENCY DOCTOR
    /// https://valkey.io/commands/latency-doctor/
    @since(version = 0.3.0-dev)
    latency-doctor: async func(connection: borrow<connection>) -> result<string, error-code>;

    /// Returns a latency graph for an event.
    ///
    /// LATENCY GRAPH event
    /// https://valkey.io/commands/latency-graph/
    @since(version = 0.3.0-dev)
    latency-graph: async func(connection: borrow<connection>, event: string) -> result<string, error-code>;

    /// Returns the cumulative distribution of latencies of a subset or all commands.
    ///
    /// LATENCY HISTOGRAM [ command [ command ... ] ]
    /// https://valkey.io/commands/latency-histogram/
    @since(version = 0.3.0-dev)
    latency-histogram: async func(connection: borrow<connection>, commands: option<list<string>>) -> result<map<string, latency-histogram-entry>, error-code>;

    /// Returns timestamp-latency samples for an event.
    ///
    /// LATENCY HISTORY event
    /// https://valkey.io/commands/latency-history/
    @since(version = 0.3.0-dev)
    latency-history: async func(connection: borrow<connection>, event: string) -> result<list<tuple<unix-time-seconds, duration-milliseconds>>, error-code>;

    /// Returns the latest latency samples for all events.
    ///
    /// LATENCY LATEST
    /// https://valkey.io/commands/latency-latest/
    @since(version = 0.3.0-dev)
    latency-latest: async func(connection: borrow<connection>) -> result<list<latency-latest-entry>, error-code>;

    /// Resets the latency data for one or more events.
    ///
    /// LATENCY RESET [ event [ event ... ] ]
    /// https://valkey.io/commands/latency-reset/
    @since(version = 0.3.0-dev)
    latency-reset: async func(connection: borrow<connection>, events: option<list<string>>) -> result<integer, error-code>;

    /// Returns all loaded modules.
    ///
    /// MODULE LIST
    /// https://valkey.io/commands/module-list/
    @since(version = 0.3.0-dev)
    module-list: async func(connection: borrow<connection>) -> result<list<module-list-entry>, error-code>;

    /// Loads a module.
    ///
    /// MODULE LOAD path [ arg [ arg ... ] ]
    /// https://valkey.io/commands/module-load/
    @since(version = 0.3.0-dev)
    module-load: async func(connection: borrow<connection>, path: string, args: option<list<string>>) -> result<_, error-code>;

    /// Loads a module using extended parameters.
    ///
    /// MODULE LOADEX path [ CONFIG name value [ CONFIG name value ... ] ] [ ARGS args [ args ... ] ]
    /// https://valkey.io/commands/module-loadex/
    @since(version = 0.3.0-dev)
    module-loadex: async func(connection: borrow<connection>, path: string, configs: option<list<tuple<string, string>>>, args: option<list<string>>) -> result<_, error-code>;

    /// Unloads a module.
    ///
    /// MODULE UNLOAD name
    /// https://valkey.io/commands/module-unload/
    @since(version = 0.3.0-dev)
    module-unload: async func(connection: borrow<connection>, name: string) -> result<_, error-code>;

    /// Configures a server as replica of another, or promotes it to a primary.
    ///
    /// None makes the server a primary, `NO ONE`.
    ///
    /// REPLICAOF 〈 host port | NO ONE 〉
    /// https://valkey.io/commands/replicaof/
    @since(version = 0.3.0-dev)
    replicaof: async func(connection: borrow<connection>, primary: option<tuple<string, u16>>) -> result<string, error-code>;

    /// Returns the replication role.
    ///
    /// ROLE
    /// https://valkey.io/commands/role/
    @since(version = 0.3.0-dev)
    role: async func(connection: borrow<connection>) -> result<role-reply, error-code>;

    /// Synchronously saves the database(s) to disk.
    ///
    /// SAVE
    /// https://valkey.io/commands/save/
    @since(version = 0.3.0-dev)
    save: async func(connection: borrow<connection>) -> result<_, error-code>;

    /// Synchronously saves the database(s) to disk and shuts down the server.
    ///
    /// The server closes the connection once it stops, so a shutdown that succeeds fails the call
    /// with a closed error.
    ///
    /// See also `shutdown-abort`.
    ///
    /// SHUTDOWN [ NOSAVE | SAVE ] [ NOW ] [ FORCE ] [ SAFE ] [ FAILOVER ]
    /// https://valkey.io/commands/shutdown/
    @since(version = 0.3.0-dev)
    shutdown: async func(connection: borrow<connection>, save: option<shutdown-save>, modifiers: shutdown-flags) -> result<_, error-code>;

    /// Synchronously saves the database(s) to disk and shuts down the server.
    ///
    /// The `ABORT` form, aborting a shutdown in progress.
    ///
    /// See also `shutdown`.
    ///
    /// SHUTDOWN ABORT
    /// https://valkey.io/commands/shutdown/
    @since(version = 0.3.0-dev)
    shutdown-abort: async func(connection: borrow<connection>) -> result<_, error-code>;

    /// Returns the slow log's entries.
    ///
    /// SLOWLOG GET [ count ]
    /// https://valkey.io/commands/slowlog-get/
    @since(version = 0.3.0-dev)
    slowlog-get: async func(connection: borrow<connection>, count: option<integer>) -> result<list<slowlog-entry>, error-code>;

    /// Returns the number of entries in the slow log.
    ///
    /// SLOWLOG LEN
    /// https://valkey.io/commands/slowlog-len/
    @since(version = 0.3.0-dev)
    slowlog-len: async func(connection: borrow<connection>) -> result<integer, error-code>;

    /// Clears all entries from the slow log.
    ///
    /// SLOWLOG RESET
    /// https://valkey.io/commands/slowlog-reset/
    @since(version = 0.3.0-dev)
    slowlog-reset: async func(connection: borrow<connection>) -> result<_, error-code>;

    /// Counts the number of set bits (population counting) in a string.
    ///
    /// BITCOUNT key [ start [ end [ BYTE | BIT ] ] ]
    /// https://valkey.io/commands/bitcount/
    @since(version = 0.3.0-dev)
    bitcount: async func(connection: borrow<connection>, key: string, range: option<bit-range>) -> result<integer, error-code>;

    /// Performs arbitrary bitfield integer operations on strings.
    ///
    /// None for a write that failed with `OVERFLOW FAIL`.
    ///
    /// BITFIELD key [ GET encoding offset | [ OVERFLOW WRAP | SAT | FAIL ] 〈 SET encoding offset value | INCRBY encoding offset increment 〉 [ GET encoding offset | [ OVERFLOW WRAP | SAT | FAIL ] 〈 SET encoding offset value | INCRBY encoding offset increment 〉 ... ] ]
    /// https://valkey.io/commands/bitfield/
    @since(version = 0.3.0-dev)
    bitfield: async func(connection: borrow<connection>, key: string, operations: option<list<bitfield-operation>>) -> result<list<option<integer>>, error-code>;

    /// Performs arbitrary read-only bitfield integer operations on strings.
    ///
    /// BITFIELD_RO key [ GET encoding offset [ GET encoding offset ... ] ]
    /// https://valkey.io/commands/bitfield_ro/
    @since(version = 0.3.0-dev)
    bitfield-ro: async func(connection: borrow<connection>, key: string, gets: option<list<bitfield-ro-get>>) -> result<list<integer>, error-code>;

    /// Performs bitwise operations on multiple strings, and stores the result.
    ///
    /// BITOP 〈 AND | OR | XOR | NOT 〉 destkey key [ key ... ]
    /// https://valkey.io/commands/bitop/
    @since(version = 0.3.0-dev)
    bitop: async func(connection: borrow<connection>, destination: string, operation: bitop-operation) -> result<integer, error-code>;

    /// Finds the first set (1) or clear (0) bit in a string.
    ///
    /// None when no bit matches, the server's `-1`.
    ///
    /// BITPOS key bit [ start [ end [ BYTE | BIT ] ] ]
    /// https://valkey.io/commands/bitpos/
    @since(version = 0.3.0-dev)
    bitpos: async func(connection: borrow<connection>, key: string, bit: bool, range: option<bit-range>) -> result<option<integer>, error-code>;

    /// Returns a bit value by offset.
    ///
    /// GETBIT key offset
    /// https://valkey.io/commands/getbit/
    @since(version = 0.3.0-dev)
    getbit: async func(connection: borrow<connection>, key: string, offset: u64) -> result<bool, error-code>;

    /// Sets or clears the bit at offset of the string value.
    ///
    /// SETBIT key offset value
    /// https://valkey.io/commands/setbit/
    @since(version = 0.3.0-dev)
    setbit: async func(connection: borrow<connection>, key: string, offset: u64, value: bool) -> result<bool, error-code>;

    /// Signals that a cluster client is following an -ASK redirect.
    ///
    /// It applies to the next command on the connection, which may be another caller's when the
    /// connection is shared. Use a connection of your own.
    ///
    /// ASKING
    /// https://valkey.io/commands/asking/
    @since(version = 0.3.0-dev)
    asking: async func(connection: borrow<connection>) -> result<_, error-code>;

    /// Authenticates the connection.
    ///
    /// AUTH [ username ] password
    /// https://valkey.io/commands/auth/
    @since(version = 0.3.0-dev)
    auth: async func(connection: borrow<connection>, username: option<string>, password: string) -> result<_, error-code>;

    /// Instructs the server whether to track the keys in the next request.
    ///
    /// It applies to the next command on the connection, which may be another caller's when the
    /// connection is shared. Use a connection of your own.
    ///
    /// CLIENT CACHING 〈 YES | NO 〉
    /// https://valkey.io/commands/client-caching/
    @since(version = 0.3.0-dev)
    client-caching: async func(connection: borrow<connection>, enabled: bool) -> result<_, error-code>;

    /// A client claims its capability.
    ///
    /// CLIENT CAPA capability [ capability ... ]
    /// https://valkey.io/commands/client-capa/
    @since(version = 0.3.0-dev)
    client-capa: async func(connection: borrow<connection>, capabilities: list<string>) -> result<_, error-code>;

    /// Returns the name of the connection.
    ///
    /// CLIENT GETNAME
    /// https://valkey.io/commands/client-getname/
    @since(version = 0.3.0-dev)
    client-getname: async func(connection: borrow<connection>) -> result<option<string>, error-code>;

    /// Returns the unique client ID of the connection.
    ///
    /// CLIENT ID
    /// https://valkey.io/commands/client-id/
    @since(version = 0.3.0-dev)
    client-id: async func(connection: borrow<connection>) -> result<integer, error-code>;

    /// Marks this client as an import source when the server is in import mode.
    ///
    /// CLIENT IMPORT-SOURCE 〈 ON | OFF 〉
    /// https://valkey.io/commands/client-import-source/
    @since(version = 0.3.0-dev)
    client-import-source: async func(connection: borrow<connection>, enabled: bool) -> result<_, error-code>;

    /// Returns information about the connection.
    ///
    /// A map of the fields, parsed from the server's text, e.g. `id`, `addr` and `name`.
    ///
    /// CLIENT INFO
    /// https://valkey.io/commands/client-info/
    @since(version = 0.3.0-dev)
    client-info: async func(connection: borrow<connection>) -> result<map<string, string>, error-code>;

    /// Controls whether commands sent by the client affect the LRU/LFU of accessed keys.
    ///
    /// It applies to the connection, so to every caller sharing it.
    ///
    /// CLIENT NO-TOUCH 〈 ON | OFF 〉
    /// https://valkey.io/commands/client-no-touch/
    @since(version = 0.3.0-dev)
    client-no-touch: async func(connection: borrow<connection>, enabled: bool) -> result<_, error-code>;

    /// Sets information specific to the client or connection.
    ///
    /// CLIENT SETINFO 〈 LIB-NAME libname | LIB-VER libver 〉
    /// https://valkey.io/commands/client-setinfo/
    @since(version = 0.3.0-dev)
    client-setinfo: async func(connection: borrow<connection>, attr: client-setinfo-attr) -> result<_, error-code>;

    /// Sets the connection name.
    ///
    /// CLIENT SETNAME connection-name
    /// https://valkey.io/commands/client-setname/
    @since(version = 0.3.0-dev)
    client-setname: async func(connection: borrow<connection>, connection-name: string) -> result<_, error-code>;

    /// Controls server-assisted client-side caching for the connection.
    ///
    /// Invalidations arrive as push messages, see `connection.dead-letters`. It applies to the
