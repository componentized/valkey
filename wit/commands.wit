    //   ZPOPMAX
    //   ZPOPMIN
    //   ZRANDMEMBER
    //   ZRANGE
    //   ZRANGEBYLEX
    //   ZRANGEBYSCORE
    //   ZRANGESTORE
    //   ZRANK
    //   ZREM
    //   ZREMRANGEBYLEX
    //   ZREMRANGEBYRANK
    //   ZREMRANGEBYSCORE
    //   ZREVRANGE
    //   ZREVRANGEBYLEX
    //   ZREVRANGEBYSCORE
    //   ZREVRANK
    //   ZSCAN
    //   ZSCORE
    //   ZUNION
    //   ZUNIONSTORE


    // stream commands

    /// The ID of a stream entry, `<milliseconds-time>-<sequence-number>`, e.g. `1526919030474-55`.
    ///
    /// Commands that add an entry also accept `*`, for the server to generate the ID.
    type stream-id = string;

    /// How a stream is trimmed, e.g. with XADD or XTRIM.
    variant stream-trim {
        /// Evicts entries as long as the stream's length exceeds the specified threshold, where threshold is a positive integer.
        maxlen(stream-trim-maxlen),
        /// Evicts entries with IDs lower than threshold, where threshold is a stream ID.
        minid(stream-trim-minid),
    }

    /// Trims the stream to a maximum length, `MAXLEN [ = | ~ ] threshold [ LIMIT count ]`.
    record stream-trim-maxlen {
        /// Exact, `=`, when none.
        efficiency: option<stream-trim-efficiency>,
        /// The maximum number of entries kept.
        threshold: integer,
        /// The maximum number of entries evicted, only with nearly exact trimming, `0` for no limit.
        limit: option<integer>,
    }

    /// Trims the entries with lower IDs, `MINID [ = | ~ ] threshold [ LIMIT count ]`.
    record stream-trim-minid {
        /// Exact, `=`, when none.
        efficiency: option<stream-trim-efficiency>,
        /// The lowest ID kept.
        threshold: stream-id,
        /// The maximum number of entries evicted, only with nearly exact trimming, `0` for no limit.
        limit: option<integer>,
    }

    /// How exactly a stream is trimmed. Nearly exact trimming is more efficient, the stream may keep a
    /// few entries more than the threshold.
    enum stream-trim-efficiency {
        /// `=`: exact trimming
        exact,
        /// `~`: nearly exact trimming
        mearly-exact,
    }

    /// Removes one or multiple messages from the Pending Entries List (PEL) of a stream consumer group.
    ///
    /// XACK key group ID [ ID ... ]
    /// https://valkey.io/commands/xack/
    xack: async func(connection: borrow<connection>, key: string, group: string, ids: list<stream-id>) -> result<integer, error>;

    /// Appends the specified stream entry to the stream at the specified key.
    ///
    /// XADD key [ NOMKSTREAM ] [ 〈 MAXLEN | MINID 〉 [ = | ~ ] threshold [ LIMIT count ] ] 〈 * | id 〉 field value [ field value ... ]
    /// https://valkey.io/commands/xadd/
    xadd: async func(connection: borrow<connection>, key: string, nomkstream: bool, trim: option<stream-trim>, id: stream-id, field-and-values: list<tuple<string, string>>) -> result<option<stream-id>, error>;

    /// Transfers ownership of pending stream entries that match the specified criteria.
    ///
    /// See also `xautoclaim-justid`
    ///
    /// A start of none scans from the beginning, `0-0`. The next start is returned, none once the scan
    /// is complete, along with the IDs of claimed entries that no longer exist, which are removed
    /// from the pending entries list.
    ///
    /// XAUTOCLAIM key group consumer min-idle-time start [ COUNT count ]
    /// https://valkey.io/commands/xautoclaim/
    xautoclaim: async func(connection: borrow<connection>, key: string, group: string, consumer: string, min-idle-time: duration, start: option<stream-id>, count: option<integer>) -> result<tuple<option<stream-id>, list<tuple<stream-id, map<string, string>>>, list<stream-id>>, error>;

    /// Transfers ownership of pending stream entries that match the specified criteria.
    ///
    /// See also `xautoclaim`
    ///
    /// A start of none scans from the beginning, `0-0`. The next start is returned, none once the scan
    /// is complete, along with the IDs of claimed entries that no longer exist, which are removed
    /// from the pending entries list.
    ///
    /// XAUTOCLAIM key group consumer min-idle-time start [ COUNT count ] JUSTID
    /// https://valkey.io/commands/xautoclaim/
    xautoclaim-justid: async func(connection: borrow<connection>, key: string, group: string, consumer: string, min-idle-time: duration, start: option<stream-id>, count: option<integer>) -> result<tuple<option<stream-id>, list<stream-id>, list<stream-id>>, error>;


    /// Options of XCLAIM.
    record xclaim-opts {
        /// `IDLE ms`: sets the idle time of the entries, the time since they were last delivered, instead
        /// of resetting it.
        idle: option<duration>,
        /// `TIME unix-time-milliseconds`: sets the idle time of the entries to the time since this instant.
        time: option<instant>,
        /// `RETRYCOUNT count`: sets the delivery count of the entries, instead of incrementing it.
        retrycount: option<integer>,
        /// `FORCE`: claims the entries even when they are not pending for any consumer, as long as they
        /// exist in the stream.
        force: bool,
        /// `LASTID lastid`: sets the ID of the last entry delivered to the group.
        lastid: option<stream-id>,
    }

    /// Changes the ownership of a pending message, so that the new owner is the consumer specified as the command argument.
    ///
    /// Also see `xclaim-justid`
    ///
    /// XCLAIM key group consumer min-idle-time ID [ ID ... ] [ IDLE ms ] [ TIME unix-time-milliseconds ] [ RETRYCOUNT count ] [ FORCE ] [ LASTID lastid ]
    /// https://valkey.io/commands/xclaim/
    xclaim: async func(connection: borrow<connection>, key: string, group: string, consumer: string, min-idle-time: duration, ids: list<stream-id>, opts: option<xclaim-opts>) -> result<list<tuple<stream-id, map<string, string>>>, error>;

    /// Changes the ownership of a pending message, so that the new owner is the consumer specified as the command argument.
    ///
    /// Also see `xclaim`
    ///
    /// XCLAIM key group consumer min-idle-time ID [ ID ... ] [ IDLE ms ] [ TIME unix-time-milliseconds ] [ RETRYCOUNT count ] [ FORCE ] JUSTID [ LASTID lastid ]
    /// https://valkey.io/commands/xclaim/
    xclaim-justid: async func(connection: borrow<connection>, key: string, group: string, consumer: string, min-idle-time: duration, ids: list<stream-id>, opts: option<xclaim-opts>) -> result<list<stream-id>, error>;

    /// Removes the specified entries from a stream, and returns the number of entries deleted.
    ///
    /// XDEL key ID [ ID ... ]
    /// https://valkey.io/commands/xdel/
    xdel: async func(connection: borrow<connection>, key: string, ids: list<stream-id>) -> result<integer, error>;

    /// Create a new consumer group uniquely identified by <groupname> for the stream stored at <key>.
    ///
    /// XGROUP CREATE key group 〈 id | $ 〉 [ MKSTREAM ] [ ENTRIESREAD entriesread ]
    /// https://valkey.io/commands/xgroup-create/
    xgroup-create: async func(connection: borrow<connection>, key: string, group: string, id: stream-id, mkstream: bool, entriesread: option<integer>) -> result<_, error>;

    /// Create a consumer named <consumername> in the consumer group <groupname> of the stream that's stored at <key>.
    ///
    /// XGROUP CREATECONSUMER key group consumer
    /// https://valkey.io/commands/xgroup-createconsumer/
    xgroup-createconsumer: async func(connection: borrow<connection>, key: string, group: string, consumer: string) -> result<bool, error>;

    /// The XGROUP DELCONSUMER command deletes a consumer from the consumer group.
    ///
    /// XGROUP DELCONSUMER key group consumer
    /// https://valkey.io/commands/xgroup-delconsumer/
    xgroup-delconsumer: async func(connection: borrow<connection>, key: string, group: string, consumer: string) -> result<integer, error>;

    /// Completely destroys the consumer group.
    ///
    /// XGROUP DESTROY key group
    /// https://valkey.io/commands/xgroup-destroy/
    xgroup-destroy: async func(connection: borrow<connection>, key: string, group: string) -> result<bool, error>;

    /// Set the last delivered ID for a consumer group.
    ///
    /// XGROUP SETID key group 〈 id | $ 〉 [ ENTRIESREAD entriesread ]
    /// https://valkey.io/commands/xgroup-setid/
    xgroup-setid: async func(connection: borrow<connection>, key: string, group: string, id: stream-id, entriesread: option<integer>) -> result<_, error>;

    /// A consumer of a group, see `xinfo-consumers`.
    record xinfo-consumer {
        /// The consumer's name.
        name: string,
        /// The number of entries pending for the consumer.
        pending: integer,
        /// The time since the consumer last attempted an interaction, e.g. XREADGROUP, XCLAIM or
        /// XAUTOCLAIM.
        idle: duration,
        /// The time since the consumer last interacted successfully, e.g. read or claimed entries.
        /// None when the consumer has never been active.
        inactive: option<duration>,
    }

    /// Consumers that belong to the <groupname> consumer group of the stream stored at <key>.
    ///
    /// XINFO CONSUMERS key group
    /// https://valkey.io/commands/xinfo-consumers/
    xinfo-consumers: async func(connection: borrow<connection>, key: string, group: string) -> result<list<xinfo-consumer>, error>;

    /// A consumer group of a stream, see `xinfo-groups`.
    record xinfo-group {
        /// The group's name.
        name: string,
        /// The number of consumers in the group.
        consumers: integer,
        /// The number of entries in the group's pending entries list (PEL), delivered but not acknowledged.
        pending: integer,
        /// The ID of the last entry delivered to the group's consumers.
        last-delivered-id: stream-id,
        /// The logical read counter of the last entry delivered to the group's consumers, none when unknown.
        entries-read: option<integer>,
        /// The number of entries in the stream not yet delivered to the group's consumers, none when it
        /// cannot be determined.
        lag: option<integer>,
    }

    /// Consumer groups of the stream stored at <key>.
    ///
    /// XINFO GROUPS key
    /// https://valkey.io/commands/xinfo-groups/
    xinfo-groups: async func(connection: borrow<connection>, key: string) -> result<list<xinfo-group>, error>;

    /// Information about a stream, see `xinfo-stream`.
    record xinfo-stream-reply {
        /// The number of entries in the stream.
        length: integer,
        /// The number of keys in the radix tree storing the stream.
        radix-tree-keys: integer,
        /// The number of nodes in the radix tree storing the stream.
        radix-tree-nodes: integer,
        /// The number of consumer groups of the stream.
        groups: integer,
        /// The ID of the last entry added to the stream, none when no entry was ever added.
        last-generated-id: option<stream-id>,
        /// The highest ID deleted from the stream, none when no entry was ever deleted.
        max-deleted-entry-id: option<stream-id>,
        /// The number of entries added to the stream over its lifetime.
        entries-added: integer,
        /// The ID and fields of the first entry.
        /// None when the stream is empty.
        first-entry: option<tuple<stream-id, map<string, string>>>,
        /// The ID and fields of the last entry.
        /// None when the stream is empty.
        last-entry: option<tuple<stream-id, map<string, string>>>,
    }

    /// Information about the stream stored at <key>.
    ///
    /// See also `xinfo-stream-full`
    ///
    /// XINFO STREAM key
    /// https://valkey.io/commands/xinfo-stream/
    xinfo-stream: async func(connection: borrow<connection>, key: string) -> result<xinfo-stream-reply, error>;

    /// Information about a stream, its entries and consumer groups, see `xinfo-stream-full`.
    record xinfo-stream-reply-full {
        /// The number of entries in the stream.
        length: integer,
        /// The number of keys in the radix tree storing the stream.
        radix-tree-keys: integer,
        /// The number of nodes in the radix tree storing the stream.
        radix-tree-nodes: integer,
        /// The ID of the last entry added to the stream, none when no entry was ever added.
        last-generated-id: option<stream-id>,
        /// The highest ID deleted from the stream, none when no entry was ever deleted.
        max-deleted-entry-id: option<stream-id>,
        /// The number of entries added to the stream over its lifetime.
        entries-added: integer,
        /// The ID and fields of the entries, in ascending ID order, up to the count given.
        entries: list<tuple<stream-id, map<string, string>>>,
        /// The consumer groups of the stream.
        groups: list<xinfo-stream-reply-full-group>,
    }

    /// A consumer group of a stream, with its pending entries and consumers.
    record xinfo-stream-reply-full-group {
        /// The group's name.
        name: string,
        /// The ID of the last entry delivered to the group's consumers.
        last-delivered-id: stream-id,
        /// The logical read counter of the last entry delivered to the group's consumers, none when unknown.
        entries-read: option<integer>,
        /// The number of entries in the stream not yet delivered to the group's consumers, none when it
        /// cannot be determined.
        lag: option<integer>,
        /// The number of entries in the group's pending entries list (PEL), delivered but not acknowledged.
        pel-count: integer,
        /// The group's pending entries, the ID of each, the consumer it was delivered to, when it was
        /// last delivered and the number of times it was delivered.
        pending: list<tuple<stream-id, string, instant, integer>>,
        /// The group's consumers.
        consumers: list<xinfo-stream-reply-full-consumer>,
    }

    /// A consumer of a group, with its pending entries.
    record xinfo-stream-reply-full-consumer {
        /// The consumer's name.
        name: string,
        /// When the consumer last attempted an interaction, e.g. XREADGROUP, XCLAIM or XAUTOCLAIM.
        seen-time: instant,
        /// When the consumer last interacted successfully, e.g. read or claimed entries.
        /// None when the consumer has never been active.
        active-time: option<instant>,
        /// The number of entries pending for the consumer, delivered but not acknowledged.
        pel-count: integer,
        /// The consumer's pending entries, the ID of each, when it was last delivered and the number of
        /// times it was delivered.
        pending: list<tuple<stream-id, instant, integer>>,
    }

    /// Information about the stream stored at <key>.
    ///
    /// See also `xinfo-stream`
    ///
    /// XINFO STREAM key FULL [ COUNT count ]
    /// https://valkey.io/commands/xinfo-stream/
    xinfo-stream-full: async func(connection: borrow<connection>, key: string, count: option<integer>) -> result<xinfo-stream-reply-full, error>;

    /// Number of entries inside a stream.
    ///
    /// XLEN key
    /// https://valkey.io/commands/xlen/
    xlen: async func(connection: borrow<connection>, key: string) -> result<integer, error>;

    /// The pending entries of a consumer group, see `xpending`.
    record xpending-summary {
        /// The number of pending entries.
        count: integer,
        /// The lowest ID of the pending entries, none when there are none.
        lowest-id: option<stream-id>,
        /// The highest ID of the pending entries, none when there are none.
        highest-id: option<stream-id>,
        /// Each consumer with pending entries, and how many it has.
        consumers: list<tuple<string, integer>>,
    }

    /// List of pending messages.
    ///
    /// See also `xpending-extended`.
    ///
    /// XPENDING key group
    /// https://valkey.io/commands/xpending/
    xpending: async func(connection: borrow<connection>, key: string, group: string) -> result<xpending-summary, error>;

    /// The pending entries of a consumer group, see `xpending-extended`.
    record xpending-extended-entry {
        /// The ID of the message.
        id: stream-id,
        /// The name of the consumer that fetched the message and has still to acknowledge it. We call it the current owner of the message.
        name: string,
        /// The number of milliseconds that elapsed since the last time this message was delivered to this consumer.
        since-delivery: duration,
        /// The number of times this message was delivered.
        delivery-count: integer,
    }

    /// List of pending messages.
    ///
    /// See also `xpending`.
    ///
    /// XPENDING key group [ IDLE min-idle-time ] start end count [ consumer ]
    /// https://valkey.io/commands/xpending/
    xpending-extended: async func(connection: borrow<connection>, key: string, group: string, min-idle-time: option<duration>, start: stream-id, end: stream-id, count: integer, consumer: option<string>) -> result<list<xpending-extended-entry>, error>;

    /// Stream entries matching a given range of IDs.
    ///
    /// XRANGE key start end [ COUNT count ]
    /// https://valkey.io/commands/xrange/
    xrange: async func(connection: borrow<connection>, key: string, start: stream-id, end: stream-id, count: option<integer>) -> result<list<tuple<stream-id, map<string, string>>>, error>;

    /// Read data from one or multiple streams, only returning entries with an ID greater than the last received ID reported by the caller.
    ///
    /// XREAD [ COUNT count ] [ BLOCK milliseconds ] STREAMS key [ key ... ] ID [ ID ... ]
    /// https://valkey.io/commands/xread/
    xread: async func(connection: borrow<connection>, count: option<integer>, block: option<duration>, keys: list<string>, ids: list<stream-id>) -> result<option<map<string, list<tuple<stream-id, map<string, string>>>>>, error>;

    /// Special version of the XREAD command with support for consumer groups.
    ///
    /// The fields of an entry are none when it was deleted after it was delivered, e.g. when reading
    /// the pending entries with the ID `0`.
    ///
    /// XREADGROUP GROUP group consumer [ COUNT count ] [ BLOCK milliseconds ] [ NOACK ] STREAMS key [ key ... ] ID [ ID ... ]
    /// https://valkey.io/commands/xreadgroup/
    xreadgroup: async func(connection: borrow<connection>, group: string, consumer: string, count: option<integer>, block: option<duration>, noack: bool, keys: list<string>, ids: list<stream-id>) -> result<option<map<string, list<tuple<stream-id, option<map<string, string>>>>>>, error>;

    /// XRANGE, but returning the entries in reverse order.
    ///
    /// XREVRANGE key end start [ COUNT count ]
    /// https://valkey.io/commands/xrevrange/
    xrevrange: async func(connection: borrow<connection>, key: string, end: stream-id, start: stream-id, count: option<integer>) -> result<list<tuple<stream-id, map<string, string>>>, error>;

    /// Internal command. It is used by a Valkey primary to replicate the last delivered ID of streams.
    ///
    /// XSETID key last-id [ ENTRIESADDED entries-added ] [ MAXDELETEDID max-deleted-id ]
    /// https://valkey.io/commands/xsetid/
    xsetid: async func(connection: borrow<connection>, key: string, last-id: stream-id, entries-added: option<integer>, max-deleted-id: option<stream-id>) -> result<_, error>;

    /// Trims the stream by evicting older entries.
    ///
    /// XTRIM key 〈 MAXLEN | MINID 〉 [ = | ~ ] threshold [ LIMIT count ]
    /// https://valkey.io/commands/xtrim/
    xtrim: async func(connection: borrow<connection>, key: string, trim: stream-trim) -> result<integer, error>;


    // string commands


    /// Appends the value at the end of the string.
    ///
    /// APPEND key value
    /// https://valkey.io/commands/append/
    append: async func(connection: borrow<connection>, key: string, value: string) -> result<integer, error>;

    /// Decrements the number stored at key by one.
    ///
    /// DECR key
    /// https://valkey.io/commands/decr/
    decr: async func(connection: borrow<connection>, key: string) -> result<integer, error>;

    /// Decrements the number stored at key by decrement.
    ///
    /// DECRBY key decrement
    /// https://valkey.io/commands/decrby/
    decrby: async func(connection: borrow<connection>, key: string, decrement: integer) -> result<integer, error>;

    /// Deletes the key if its value matches the given string.
    ///
    /// DELIFEQ key value
    /// https://valkey.io/commands/delifeq/
    delifeq: async func(connection: borrow<connection>, key: string, value: string) -> result<bool, error>;


    /// Get the value of key.
    ///
    /// GET key
    /// https://valkey.io/commands/get/
    get: async func(connection: borrow<connection>, key: string) -> result<option<string>, error>;

    /// Get the value of key and delete the key.
    ///
    /// GETDEL key
    /// https://valkey.io/commands/getdel/
    getdel: async func(connection: borrow<connection>, key: string) -> result<option<string>, error>;

    /// The expiration to set on a key, see `getex`.
    variant getex-ttl {
        /// Set the specified expire time, in seconds.
        ex(duration),
        /// Set the specified expire time, in milliseconds.
        px(duration),
        /// Set the specified Unix time at which the key will expire, in seconds.
        exat(instant),
        /// Set the specified Unix time at which the key will expire, in milliseconds.
        pxat(instant),
        /// Remove the time to live associated with the key.
        persist,
    }

    /// Get the value of key and optionally set its expiration.
    ///
    /// GETEX key [ EX seconds | PX milliseconds | EXAT unix-time-seconds | PXAT unix-time-milliseconds | PERSIST ]
    /// https://valkey.io/commands/getex/
    getex: async func(connection: borrow<connection>, key: string, ttl: option<getex-ttl>) -> result<option<string>, error>;

    /// Returns the substring of the string value stored at key, determined by the offsets start and end.
    ///
    /// GETRANGE key start end
    /// https://valkey.io/commands/getrange/
    getrange: async func(connection: borrow<connection>, key: string, start: integer, end: integer) -> result<string, error>;

    /// Atomically sets key to value and returns the old value stored at key.
    ///
    /// GETSET key value
    /// https://valkey.io/commands/getset/
    getset: async func(connection: borrow<connection>, key: string, value: string) -> result<option<string>, error>;

    /// Increments the number stored at key by one.
    ///
    /// INCR key
    /// https://valkey.io/commands/incr/
    incr: async func(connection: borrow<connection>, key: string) -> result<integer, error>;

    /// Increments the number stored at key by increment.
    ///
    /// INCRBY key increment
    /// https://valkey.io/commands/incrby/
    incrby: async func(connection: borrow<connection>, key: string, increment: integer) -> result<integer, error>;

    /// Increment the string representing a floating point number stored at key by the specified increment.
    ///
    /// INCRBYFLOAT key increment
    /// https://valkey.io/commands/incrbyfloat/
    incrbyfloat: async func(connection: borrow<connection>, key: string, increment: double) -> result<double, error>;

    /// The LCS command implements the longest common subsequence algorithm.
    ///
    /// See also `lcs-len` and `lcs-idx`
    ///
    /// LCS key1 key2
    /// https://valkey.io/commands/lcs/
    lcs: async func(connection: borrow<connection>, key1: string, key2: string) -> result<string, error>;

    /// The LCS command implements the longest common subsequence algorithm.
    ///
    /// See also `lcs` and `lcs-idx`
    ///
    /// LCS key1 key2 LEN
    /// https://valkey.io/commands/lcs/
    lcs-len: async func(connection: borrow<connection>, key1: string, key2: string) -> result<integer, error>;

    /// The longest common subsequence of two strings, as the ranges matching in each, see `lcs-idx`.
    record lcs-idx-reply {
        /// The ranges that match, from the end of the strings to their start.
        matches: list<lcs-idx-match>,
        /// The length of the longest common subsequence.
        len: integer,
    }

    /// A part of the longest common subsequence.
    record lcs-idx-match {
        /// The inclusive start and end positions of the match in the first key's string.
        key1-range: tuple<integer, integer>,
        /// The inclusive start and end positions of the match in the second key's string.
        key2-range: tuple<integer, integer>,
        /// The length of the match, with `with-match-len`.
        len: option<integer>,
    }

    /// The LCS command implements the longest common subsequence algorithm.
    ///
    /// See also `lcs` and `lcs-len`
    ///
    /// LCS key1 key2 IDX [ MINMATCHLEN min-match-len ] [ WITHMATCHLEN ]
    /// https://valkey.io/commands/lcs/
    lcs-idx: async func(connection: borrow<connection>, key1: string, key2: string, min-match-len: option<integer>, with-match-len: bool ) -> result<lcs-idx-reply, error>;

    /// Returns the values of all specified keys.
    ///
    /// MGET key [ key ... ]
    /// https://valkey.io/commands/mget/
    mget: async func(connection: borrow<connection>, keys: list<string>) -> result<list<option<string>>, error>;

    /// Sets the given keys to their respective values.
    ///
    /// MSET key value [ key value ... ]
    /// https://valkey.io/commands/mset/
    mset: async func(connection: borrow<connection>, keys-and-values: list<tuple<string, string>>) -> result<_, error>;

    /// The condition for setting the keys, see `msetex`.
    variant msetex-precondition {
        /// Only set the keys if all of them do not already exist.
        nx,
        /// Only set the keys if all of them already exist.
        xx,
    }

    /// The expiration to set on the keys, see `msetex`.
    type msetex-ttl = set-ttl;

    /// Sets multiple key-value pairs while also assigning a shared expiration time to all the keys atomically.
    ///
    /// MSETEX numkeys key value [ key value ... ] [ NX | XX ] [ EX seconds | PX milliseconds | EXAT unix-time-seconds | PXAT unix-time-milliseconds | KEEPTTL ]
    /// https://valkey.io/commands/msetex/
    msetex: async func(connection: borrow<connection>, keys-and-values: list<tuple<string, string>>, precondition: option<msetex-precondition>, ttl: option<msetex-ttl>) -> result<bool, error>;

    /// Sets the given keys to their respective values.
    ///
    /// MSETNX key value [ key value ... ]
    /// https://valkey.io/commands/msetnx/
    msetnx: async func(connection: borrow<connection>, keys-and-values: list<tuple<string, string>>) -> result<bool, error>;

    /// Set key to hold the string value with expiration in milliseconds.
    ///
    /// PSETEX key milliseconds value
    /// https://valkey.io/commands/psetex/
    psetex: async func(connection: borrow<connection>, key: string, milliseconds: duration, value: string) -> result<_, error>;

    /// The condition for setting a key, see `set`.
    variant set-precondition {
        /// Only set the key if it does not already exist.
        nx,
        /// Only set the key if it already exists.
        xx,
        /// Set the key if the comparison value matches the existing value.
        ifeq(string),
        /// Set the key if the comparison value does not match the existing value.
        ifne(string),
    }

    /// The expiration to set on a key, see `set`.
    variant set-ttl {
        /// Set the specified expire time, in seconds.
        ex(duration),
        /// Set the specified expire time, in milliseconds.
        px(duration),
        /// Set the specified Unix time at which the key will expire, in seconds.
        exat(instant),
        /// Set the specified Unix time at which the key will expire, in milliseconds.
        pxat(instant),
        /// Retain the time to live associated with the keys.
        keepttl,
    }

    /// Set key to hold the string value.
    ///
    /// Returns false when the precondition is not met, the key is unchanged.
    ///
    /// SET key value [ NX | XX | IFEQ comparison-value | IFNE comparison-not-equal ] [ EX seconds | PX milliseconds | EXAT unix-time-seconds | PXAT unix-time-milliseconds | KEEPTTL ]
    /// https://valkey.io/commands/set/
    set: async func(connection: borrow<connection>, key: string, value: string, precondition: option<set-precondition>, ttl: option<set-ttl>) -> result<bool, error>;

    /// Set key to hold the string value. Returning the previous value.
    ///
    /// SET key value [ NX | XX | IFEQ comparison-value | IFNE comparison-not-equal ] GET [ EX seconds | PX milliseconds | EXAT unix-time-seconds | PXAT unix-time-milliseconds | KEEPTTL ]
    /// https://valkey.io/commands/set/
    set-get: async func(connection: borrow<connection>, key: string, value: string, precondition: option<set-precondition>, ttl: option<set-ttl>) -> result<option<string>, error>;

    /// Set key to hold the string value with expiration in seconds.
    ///
    /// SETEX key seconds value
    /// https://valkey.io/commands/setex/
    setex: async func(connection: borrow<connection>, key: string, seconds: duration, value: string) -> result<_, error>;

    /// Set key to hold string value if key does not exist.
    ///
    /// SETNX key value
    /// https://valkey.io/commands/setnx/
    setnx: async func(connection: borrow<connection>, key: string, value: string) -> result<bool, error>;

    /// Overwrites part of the string stored at key, starting at the specified offset, for the entire length of value.
    ///
    /// SETRANGE key offset value
    /// https://valkey.io/commands/setrange/
    setrange: async func(connection: borrow<connection>, key: string, offset: u32, value: string) -> result<integer, error>;

    /// Returns the length of the string value stored at key.
    ///
    /// STRLEN key
    /// hthttps://valkey.io/commands/strlen/
    strlen: async func(connection: borrow<connection>, key: string) -> result<integer, error>;

    /// Returns the substring of the string value stored at key, determined by the offsets start and end.
    ///
    /// SUBSTR key start end
    /// https://valkey.io/commands/substr/
    substr: async func(connection: borrow<connection>, key: string, start: integer, end: integer) -> result<string, error>;


    // transaction commands

    // not yet implemented, from the @transaction category:
    //   DISCARD
    //   EXEC
    //   MULTI
    //   UNWATCH
    //   WATCH

}
