    // hash commands

    /// Removes the specified fields from the hash stored at key.
    ///
    /// HDEL key field [ field ... ]
    /// https://valkey.io/commands/hdel/
    hdel: async func(connection: borrow<connection>, key: string, fields: list<string>) -> result<integer, error>;

    /// Returns if field is an existing field in the hash stored at key.
    ///
    /// HEXISTS key field
    /// https://valkey.io/commands/hexists/
    hexists: async func(connection: borrow<connection>, key: string, field: string) -> result<bool, error>;

    /// Manipulate the expiration time for existing hash fields.
    ///
    /// HEXPIRE key seconds [ NX | XX | GT | LT ] FIELDS numfields field [ field ... ]
    /// https://valkey.io/commands/hexpire/
    hexpire: async func(connection: borrow<connection>, key: string, seconds: duration, mode: option<ttl-mode>, fields: list<string>) -> result<list<ttl-result>, error>;

    /// Manipulate the expiration time for existing hash fields.
    ///
    /// HEXPIREAT key unix-time-seconds [ NX | XX | GT | LT ] FIELDS numfields field [ field ... ]
    /// https://valkey.io/commands/hexpireat/
    hexpireat: async func(connection: borrow<connection>, key: string, seconds: instant, mode: option<ttl-mode>, fields: list<string>) -> result<list<ttl-result>, error>;

    /// Returns the value associated with field in the hash stored at key.
    ///
    /// HGET key field
    /// https://valkey.io/commands/hget/
    hget: async func(connection: borrow<connection>, key: string, field: string) -> result<option<string>, error>;

    /// Returns all fields and values of the hash stored at key.
    ///
    /// HGETALL key
    /// https://valkey.io/commands/hgetall/
    hgetall: async func(connection: borrow<connection>, key: string) -> result<map<string, string>, error>;

    /// Increments the number stored at field in the hash stored at key by increment.
    ///
    /// HINCRBY key field increment
    /// https://valkey.io/commands/hincrby/
    hincrby: async func(connection: borrow<connection>, key: string, field: string, increment: integer) -> result<integer, error>;

    /// Increment the specified field of a hash stored at key, and representing a floating point number, by the specified increment.
    ///
    /// HINCRBYFLOAT key field increment
    /// https://valkey.io/commands/hincrbyfloat/
    hincrbyfloat: async func(connection: borrow<connection>, key: string, field: string, increment: double) -> result<double, error>;

    /// Returns all field names in the hash stored at key.
    ///
    /// HKEYS key
    /// https://valkey.io/commands/hkeys/
    hkeys: async func(connection: borrow<connection>, key: string) -> result<list<string>, error>;

    /// Returns the number of fields contained in the hash stored at key.
    ///
    /// HLEN key
    /// https://valkey.io/commands/hlen/
    hlen: async func(connection: borrow<connection>, key: string) -> result<integer, error>;

    /// Returns the values associated with the specified fields in the hash stored at key.
    ///
    /// HMGET key field [ field ... ]
    /// https://valkey.io/commands/hmget/
    hmget: async func(connection: borrow<connection>, key: string, fields: list<string>) -> result<list<option<string>>, error>;

    /// Sets the specified fields to their respective values in the hash stored at key.
    ///
    /// HMSET key field value [ field value ... ]
    /// https://valkey.io/commands/hmset/
    hmset: async func(connection: borrow<connection>, key: string, field-and-values: list<tuple<string, string>>) -> result<_, error>;

    /// Random fields from the hash value stored at key, up to the count.
    ///
    /// Without a count, one field, or none when the key does not exist. A negative count may return
    /// the same field more than once, its absolute value is the number of fields returned.
    ///
    /// Also see `hrandfield-withvalues`.
    ///
    /// HRANDFIELD key [ count ]
    /// https://valkey.io/commands/hrandfield/
    hrandfield: async func(connection: borrow<connection>, key: string, count: option<integer>) -> result<list<string>, error>;

    /// Random fields and their values from the hash value stored at key, up to the count.
    ///
    /// A negative count may return the same field more than once, its absolute value is the number of
    /// fields returned.
    ///
    /// Also see `hrandfield`.
    ///
    /// HRANDFIELD key count WITHVALUES
    /// https://valkey.io/commands/hrandfield/
    hrandfield-withvalues: async func(connection: borrow<connection>, key: string, count: integer) -> result<list<tuple<string, string>>, error>;

    /// The position of an incremental iteration, e.g. with HSCAN.
    ///
    /// None starts a new iteration, the iteration is complete once the cursor returned is `0`.
    type cursor = string;

    /// Incrementally iterate over a collection of elements.
    ///
    /// See also `hscan-novalues`.
    ///
    /// HSCAN key cursor [ MATCH pattern ] [ COUNT count ]
    /// https://valkey.io/commands/hscan/
    hscan: async func(connection: borrow<connection>, key: string, cursor: option<cursor>, match: option<string>, count: option<integer>) -> result<tuple<cursor, map<string, string>>, error>;

    /// Incrementally iterate over a collection of keys.
    ///
    /// See also `hscan`.
    ///
    /// HSCAN key cursor [ MATCH pattern ] [ COUNT count ] NOVALUES
    /// https://valkey.io/commands/hscan/
    hscan-novalues: async func(connection: borrow<connection>, key: string, cursor: option<cursor>, match: option<string>, count: option<integer>) -> result<tuple<cursor, list<string>>, error>;

    /// Sets the specified fields to their respective values in the hash stored at key.
    ///
    /// HSET key field value [ field value ... ]
    /// https://valkey.io/commands/hset/
    hset: async func(connection: borrow<connection>, key: string, field-and-values: list<tuple<string, string>>) -> result<integer, error>;

    /// Sets field in the hash stored at key to value, only if field does not yet exist.
    ///
    /// HSETNX key field value
    /// https://valkey.io/commands/hsetnx/
    hsetnx: async func(connection: borrow<connection>, key: string, field: string, value: string) -> result<bool, error>;

    /// Returns the string length of the value associated with field in the hash stored at key.
    ///
    /// HSTRLEN key field
    /// https://valkey.io/commands/hstrlen/
    hstrlen: async func(connection: borrow<connection>, key: string, field: string) -> result<integer, error>;

    /// All values in the hash stored at key.
    ///
    /// HVALS key
    /// https://valkey.io/commands/hvals/
    hvals: async func(connection: borrow<connection>, key: string) -> result<list<string>, error>;

