    /// https://valkey.io/commands/geosearch/
    @since(version = 0.3.0-dev)
    geosearch: async func(connection: borrow<connection>, key: string, shape: geosearch-shape, order: option<sort-order>, count: option<geosearch-count>) -> result<list<string-or-bytes>, error-code>;

    /// Queries a geospatial index for members inside an area of a box, circle, or a polygon.
    ///
    /// Returns each member with the details asked for, `WITHCOORD`, `WITHDIST` and `WITHHASH`.
    ///
    /// See also `geosearch`.
    ///
    /// GEOSEARCH key [ FROMMEMBER member | FROMLONLAT longitude latitude ] 〈 BYRADIUS radius 〈 m | km | ft | mi 〉 | BYBOX width height 〈 m | km | ft | mi 〉 | BYPOLYGON num-vertices longitude latitude [ longitude latitude ... ] 〉 [ ASC | DESC ] [ COUNT count [ ANY ] ] [ WITHCOORD ] [ WITHDIST ] [ WITHHASH ]
    /// https://valkey.io/commands/geosearch/
    @since(version = 0.3.0-dev)
    geosearch-with: async func(connection: borrow<connection>, key: string, shape: geosearch-shape, order: option<sort-order>, count: option<geosearch-count>, details: geosearch-with-flags) -> result<list<geosearch-with-result>, error-code>;

