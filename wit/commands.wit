/// Typed functions for Valkey's commands, over the mechanics of a connection.
///
/// A list argument must have at least one item, as the command requires, an empty list fails with a
/// client error before anything is sent. A list the command allows to be left out is an option,
/// none rather than empty.
interface commands {
    use connection.{connection, double, integer, value, error};

    /// A duration in whole seconds, e.g. `EX seconds`.
    record duration-seconds {
        ex: u64,
    }

    /// A duration in whole milliseconds, e.g. `PX milliseconds`.
    record duration-milliseconds {
        px: u64,
    }

    /// A point in time as whole seconds since the Unix epoch, e.g. `EXAT unix-time-seconds`.
    record unix-time-seconds {
        exat: s64,
    }

    /// A point in time as whole milliseconds since the Unix epoch, e.g. `PXAT
    /// unix-time-milliseconds`.
    record unix-time-milliseconds {
        pxat: s64,
    }

    /// Where an incremental iteration continues from, e.g. with HSCAN.
    ///
    /// A scan returns the cursor to resume from, always `resume`, none once the scan is complete.
    /// Pass it to the next call until then.
    variant cursor {
        /// Starts a new scan, the cursor `0`.
        start,
        /// Continues a scan from the opaque cursor the previous call returned, `0` fails with a client
        /// error, use `start`.
        resume(string),
    }

    /// XXXXXX
    ///
    /// XXXXXX
    /// https://valkey.io/commands/XXXXXX/


    /// The condition for setting an expiration, e.g. with EXPIRE or HEXPIRE.
    enum ttl-mode {
        /// Set expiration only when the field has no expiration.
        nx,
        /// Set expiration only when the field has an existing expiration.
        xx,
        /// Set expiration only when the new expiration is greater than current one.
        gt,
        /// Set expiration only when the new expiration is less than current one.
        lt,
    }

    /// The outcome of setting the expiration of a hash field, e.g. with HEXPIRE.
    enum ttl-result {
        /// -2: key does not exist, or field does not exist in the HASH.
        does-not-exist,
        /// 0: the specified NX | XX | GT | LT condition has not been met.
        condition-not-met,
        /// 1: the expiration time was applied.
        applied,
        /// 2: when called with 0 seconds.
        zero-seconds,
    }

    // admin commands

    /// Delete all the specified ACL users and terminate all the connections that are authenticated with such users.
    ///
    /// ACL DELUSER username [ username ... ]
    /// https://valkey.io/commands/acl-deluser/
    acl-deluser: async func(connection: borrow<connection>, usernames: list<string>) -> result<integer, error>;

    /// Generates a random password.
    ///
    /// ACL GENPASS [ bits ]
    /// https://valkey.io/commands/acl-genpass/
    acl-genpass: async func(connection: borrow<connection>, bits: option<integer>) -> result<string, error>;

    /// A rule of an ACL user, see `acl-setuser`.
    ///
    /// https://valkey.io/topics/acl/
    variant rule {
        /// The keys the user may access.
        keys(key-rule),
        /// The Pub/Sub channels the user may access.
        channel(channel-rule),
        /// The commands the user may call.
        command(command-rule),
        /// The databases the user may access.
        db(db-rule),
        /// The user itself, e.g. whether it is enabled and its passwords.
        user(user-rule),
    }

    /// A rule of a selector, a set of permissions matched independently of the user's root permissions,
    /// the user may run a command when either permits it.
    variant rule-selector {
        /// The keys the selector permits access to.
        keys(key-rule),
        /// The Pub/Sub channels the selector permits access to.
        channel(channel-rule),
        /// The commands the selector permits.
        command(command-rule),
        /// The databases the selector permits access to.
        db(db-rule),
    }

    /// A rule for the keys a user may access.
    variant key-rule {
        /// `~<pattern>`: allows reading and writing the keys matching the glob-style pattern.
        add(string),
        /// `%R~<pattern>`: allows reading the keys matching the glob-style pattern.
        add-read(string),
        /// `%W~<pattern>`: allows writing the keys matching the glob-style pattern.
        add-write(string),
        /// `%RW~<pattern>`: allows reading and writing the keys matching the glob-style pattern, the
        /// same as `add`.
        add-read-write(string),
        /// `allkeys`: allows access to all keys, an alias for `~*`.
        all,
        /// `resetkeys`: removes all the allowed key patterns.
        reset,
    }

    /// A rule for the Pub/Sub channels a user may access.
    variant channel-rule {
        /// `&<pattern>`: allows access to the Pub/Sub channels matching the glob-style pattern.
        add(string),
        /// `allchannels`: allows access to all Pub/Sub channels, an alias for `&*`.
        all,
        /// `resetchannels`: removes all the allowed channel patterns, disconnecting the user's Pub/Sub
        /// clients that can no longer access their channels.
        reset,
    }

    /// A rule for the commands a user may call.
    variant command-rule {
        /// `+<command>`: allows the command, or a subcommand, e.g. `config|get`.
        add(string),
        /// `+@<category>`: allows all the commands in the category, e.g. `read`, see ACL CAT for the
        /// categories.
        add-category(string),
        /// `+<command>|<first-arg>`: allows the command only with the given first argument, e.g. `select`
        /// with `0`.
        add-first-arg(tuple<string, string>),
        /// `allcommands`: allows all commands, including those of modules loaded later, an alias for `+@all`.
        all,
        /// `-<command>`: disallows the command, or a subcommand.
        remove(string),
        /// `-@<category>`: disallows all the commands in the category.
        remove-category(string),
        /// `nocommands`: disallows all commands, an alias for `-@all`.
        reset,
    }

    /// A rule for the databases a user may access.
    variant db-rule {
        /// `db=<id>[,<id>...]`: allows access to the databases with the given IDs.
        db(list<u8>),
        /// `alldbs`: allows access to all databases.
        all,
        /// `resetdbs`: removes all the allowed databases.
        reset,
    }

    /// A rule for the user itself.
    variant user-rule {
        /// `on`: enables the user, it is possible to authenticate as this user.
        on,
        /// `off`: disables the user, it is no longer possible to authenticate as this user, connections
        /// already authenticated keep working.
        off,
        /// `nopass`: removes all the user's passwords, any password then authenticates as the user.
        nopass,
        /// `><password>`: adds the password to the user's passwords.
        password(string),
        /// `#<hash>`: adds a password, by its SHA-256 hash as 64 lowercase hex characters, to the user's
        /// passwords.
        hashed-password(string),
        /// `<<password>`: removes the password from the user's passwords.
        remove-password(string),
        /// `!<hash>`: removes a password, by its SHA-256 hash, from the user's passwords.
        remove-hashed-password(string),
        /// `(<rule> ...)`: adds a selector, with the given rules.
        selector(list<rule-selector>),
        /// `clearselectors`: removes all the user's selectors.
        clearselectors,
        /// `reset`: resets the user to its state when created, disabled, without passwords, keys,
        /// channels, commands or selectors.
        reset,
    }

    /// Create an ACL user with the specified rules or modify the rules of an existing user.
    ///
    /// ACL SETUSER username [ rule ] [ [ rule ] ... ]
    /// https://valkey.io/commands/acl-setuser/
    acl-setuser: async func(connection: borrow<connection>, username: string, rules: option<list<rule>>) -> result<_, error>;


    // not yet implemented, from the @admin category:
    //   ACL CAT
    //   ACL DRYRUN
    //   ACL GETUSER
    //   ACL LIST
    //   ACL LOAD
    //   ACL LOG
    //   ACL SAVE
    //   ACL USERS
    //   ACL WHOAMI
    //   BGREWRITEAOF
    //   BGSAVE
    //   CLIENT KILL
    //   CLIENT LIST
    //   CLIENT NO-EVICT
    //   CLIENT PAUSE
    //   CLIENT UNBLOCK
    //   CLIENT UNPAUSE
    //   CLUSTER ADDSLOTS
    //   CLUSTER ADDSLOTSRANGE
    //   CLUSTER BUMPEPOCH
    //   CLUSTER CANCELSLOTMIGRATIONS
    //   CLUSTER COUNT-FAILURE-REPORTS
    //   CLUSTER DELSLOTS
    //   CLUSTER DELSLOTSRANGE
    //   CLUSTER FAILOVER
    //   CLUSTER FLUSHSLOT
    //   CLUSTER FLUSHSLOTS
    //   CLUSTER FORGET
    //   CLUSTER GETSLOTMIGRATIONS
    //   CLUSTER MEET
    //   CLUSTER MIGRATESLOTS
    //   CLUSTER REPLICAS
    //   CLUSTER REPLICATE
    //   CLUSTER RESET
    //   CLUSTER SAVECONFIG
    //   CLUSTER SET-CONFIG-EPOCH
    //   CLUSTER SETSLOT
    //   CLUSTER SLAVES
    //   CLUSTER SYNCSLOTS
    //   COMMANDLOG GET
    //   COMMANDLOG LEN
    //   COMMANDLOG RESET
    //   CONFIG GET
    //   CONFIG RESETSTAT
    //   CONFIG REWRITE
    //   CONFIG SET
    //   DEBUG
    //   FAILOVER
    //   LASTSAVE
    //   LATENCY DOCTOR
    //   LATENCY GRAPH
    //   LATENCY HISTOGRAM
    //   LATENCY HISTORY
    //   LATENCY LATEST
    //   LATENCY RESET
    //   MODULE LIST
    //   MODULE LOAD
    //   MODULE LOADEX
    //   MODULE UNLOAD
    //   MONITOR
    //   PFDEBUG
    //   PFSELFTEST
    //   PSYNC
    //   REPLCONF
    //   REPLICAOF
    //   ROLE
    //   SAVE
    //   SHUTDOWN
    //   SLAVEOF
    //   SLOWLOG GET
    //   SLOWLOG LEN
    //   SLOWLOG RESET
    //   SYNC


    // bitmap commands

    /// A range of a string, negative from the end, for BITCOUNT and BITPOS.
    variant bit-range {
        /// `start`: the bytes from the start to the end of the string.
        %from(integer),
        /// `start end`: the bytes from the start to the end, both included.
        bytes(tuple<integer, integer>),
        /// `start end BIT`: the bits from the start to the end, both included.
        bits(tuple<integer, integer>),
    }

    /// The number of bits set to 1 in the string stored at key, in the range, 0 when the key does
    /// not exist.
    ///
    /// BITCOUNT key [ start [ end [ BYTE | BIT ] ] ]
    /// https://valkey.io/commands/bitcount/
    bitcount: async func(connection: borrow<connection>, key: string, range: option<bit-range>) -> result<integer, error>;

    /// The type of an integer field of a string, for BITFIELD.
    variant bitfield-encoding {
        /// `i1` to `i64`: a signed integer of the width in bits.
        signed(u8),
        /// `u1` to `u63`: an unsigned integer of the width in bits.
        unsigned(u8),
    }

    /// Where an integer field of a string starts, for BITFIELD.
    variant bitfield-offset {
        /// The offset in bits.
        bit(u64),
        /// `#field`: the field of the encoding's width, the offset in bits is the field times the
        /// width.
        field(u64),
    }

    /// What a write does when the field overflows, `OVERFLOW`.
    enum bitfield-overflow {
        /// `WRAP`: wraps around, the default.
        wrap,
        /// `SAT`: saturates at the minimum or maximum.
        sat,
        /// `FAIL`: does not write, the result is none.
        fail,
    }

    /// `GET encoding offset`: the value of the field.
    record bitfield-get {
        encoding: bitfield-encoding,
        offset: bitfield-offset,
    }

    /// `SET encoding offset value`: sets the field, the result is its previous value.
    record bitfield-set {
        encoding: bitfield-encoding,
        offset: bitfield-offset,
        value: s64,
    }

    /// `INCRBY encoding offset increment`: increments the field, the result is its new value.
    record bitfield-incrby {
        encoding: bitfield-encoding,
        offset: bitfield-offset,
        increment: s64,
    }

    /// An operation of BITFIELD.
    ///
    /// A write is preceded by an optional overflow mode, `OVERFLOW WRAP | SAT | FAIL`, for it and
    /// the following writes. None keeps the current mode, `WRAP` at the start of the command.
    variant bitfield-operation {
        /// `GET encoding offset`
        get(bitfield-get),
        /// `[ OVERFLOW WRAP | SAT | FAIL ] SET encoding offset value`
        set(tuple<option<bitfield-overflow>, bitfield-set>),
        /// `[ OVERFLOW WRAP | SAT | FAIL ] INCRBY encoding offset increment`
        incrby(tuple<option<bitfield-overflow>, bitfield-incrby>),
    }

    /// Reads and writes integer fields of the string stored at key, returning the result of each
    /// operation in order, none for a write that failed with `OVERFLOW FAIL`.
    ///
    /// BITFIELD key [ GET encoding offset | [ OVERFLOW WRAP | SAT | FAIL ] 〈 SET encoding offset value | INCRBY encoding offset increment 〉 [ GET encoding offset | [ OVERFLOW WRAP | SAT | FAIL ] 〈 SET encoding offset value | INCRBY encoding offset increment 〉 ... ] ]
    /// https://valkey.io/commands/bitfield/
    bitfield: async func(connection: borrow<connection>, key: string, operations: option<list<bitfield-operation>>) -> result<list<option<integer>>, error>;

    /// Reads integer fields of the string stored at key, the read-only variant of `bitfield`.
    ///
    /// BITFIELD_RO key [ GET encoding offset [ GET encoding offset ... ] ]
    /// https://valkey.io/commands/bitfield_ro/
    bitfield-ro: async func(connection: borrow<connection>, key: string, gets: option<list<bitfield-get>>) -> result<list<integer>, error>;

    /// A bitwise operation of BITOP, and its source keys.
    variant bitop-operation {
        /// `AND`
        and(list<string>),
        /// `OR`
        or(list<string>),
        /// `XOR`
        xor(list<string>),
        /// `NOT`: of a single key.
        not(string),
    }

    /// Stores the bitwise operation of the strings stored at the source keys in the destination,
    /// returning its length, the length of the longest source.
    ///
    /// BITOP 〈 AND | OR | XOR | NOT 〉 destkey key [ key ... ]
    /// https://valkey.io/commands/bitop/
    bitop: async func(connection: borrow<connection>, destination: string, operation: bitop-operation) -> result<integer, error>;

    /// The position of the first bit set to the bit in the string stored at key, in the range,
    /// none when there is none.
    ///
    /// BITPOS key bit [ start [ end [ BYTE | BIT ] ] ]
    /// https://valkey.io/commands/bitpos/
    bitpos: async func(connection: borrow<connection>, key: string, bit: bool, range: option<bit-range>) -> result<option<integer>, error>;

    /// The bit at the offset of the string stored at key, false beyond its end, or when the key
    /// does not exist.
    ///
    /// GETBIT key offset
    /// https://valkey.io/commands/getbit/
    getbit: async func(connection: borrow<connection>, key: string, offset: u64) -> result<bool, error>;

    /// Sets the bit at the offset of the string stored at key, growing it as needed, returning the
    /// previous bit.
    ///
    /// SETBIT key offset value
    /// https://valkey.io/commands/setbit/
    setbit: async func(connection: borrow<connection>, key: string, offset: u64, value: bool) -> result<bool, error>;


    // connection commands

    /// Authenticates the current connection.
    ///
    /// AUTH [ username ] password
    /// https://valkey.io/commands/auth/
    auth: async func(connection: borrow<connection>, username: option<string>, password: string) -> result<_, error>;

    /// Switch to a different protocol, optionally authenticating and setting the connection's name, or provide a contextual client report.
    ///
    /// RESP2 is not fully supported by this client.
    ///
    /// HELLO 3 [ AUTH username password ] [ SETNAME clientname ]
    /// https://valkey.io/commands/hello/
    hello: async func(connection: borrow<connection>, auth: option<tuple<string, string>>, client-name: option<string>) -> result<map<string, value>, error>;

    /// Returns PONG if no argument is provided, otherwise return a copy of the argument as a bulk.
    ///
    /// PING [ message ]
    /// https://valkey.io/commands/ping/
    ping: async func(connection: borrow<connection>, message: option<string>) -> result<_, error>;

    // not yet implemented, from the @connection category:
    //   ASKING
    //   CLIENT CACHING
    //   CLIENT CAPA
    //   CLIENT GETNAME
    //   CLIENT GETREDIR
    //   CLIENT ID
    //   CLIENT IMPORT-SOURCE
    //   CLIENT INFO
    //   CLIENT KILL
    //   CLIENT LIST
    //   CLIENT NO-EVICT
    //   CLIENT NO-TOUCH
    //   CLIENT PAUSE
    //   CLIENT REPLY
    //   CLIENT SETINFO
    //   CLIENT SETNAME
    //   CLIENT TRACKING
    //   CLIENT TRACKINGINFO
    //   CLIENT UNBLOCK
    //   CLIENT UNPAUSE
    //   COMMAND
    //   COMMAND COUNT
    //   COMMAND DOCS
    //   COMMAND GETKEYS
    //   COMMAND GETKEYSANDFLAGS
    //   COMMAND INFO
    //   COMMAND LIST
    //   ECHO
    //   QUIT
    //   READONLY
    //   READWRITE
    //   RESET
    //   SELECT
    //   WAIT
    //   WAITAOF


    // geo commands

    /// A position on the Earth.
    ///
    /// The exact limits, as specified by EPSG:900913 / EPSG:3785 / OSGEO:41001
    record geo-coordinates {
        /// The longitude, from -180 to 180 degrees.
        longitude: double,
        /// The latitude, from -85.05112878 to 85.05112878 degrees.
        latitude: double,
    }

    /// A unit of distance.
    enum geo-unit {
        /// `m`: meters.
        m,
        /// `km`: kilometers.
        km,
        /// `ft`: feet.
        ft,
        /// `mi`: miles.
        mi,
    }

    /// Only add or only update members, GEOADD's `NX` and `XX`.
    enum geoadd-condition {
        /// Only add new members, never update existing ones.
        nx,
        /// Only update existing members, never add new ones.
        xx,
    }

    /// Adds the members at their positions to the geospatial index stored at key, or updates their
    /// positions, returning how many were added, or with `changed`, added or updated.
    ///
    /// GEOADD key [ NX | XX ] [ CH ] longitude latitude member [ longitude latitude member ... ]
    /// https://valkey.io/commands/geoadd/
    geoadd: async func(connection: borrow<connection>, key: string, condition: option<geoadd-condition>, changed: bool, coordinates-and-members: list<tuple<geo-coordinates, string>>) -> result<integer, error>;

    /// The distance between the members, in meters or the unit, none when either is not a member.
    ///
    /// GEODIST key member1 member2 [ m | km | ft | mi ]
    /// https://valkey.io/commands/geodist/
    geodist: async func(connection: borrow<connection>, key: string, member1: string, member2: string, unit: option<geo-unit>) -> result<option<double>, error>;

    /// The geohash of each of the members, none for a member that is not in the index.
    ///
    /// GEOHASH key [ member [ member ... ] ]
    /// https://valkey.io/commands/geohash/
    geohash: async func(connection: borrow<connection>, key: string, members: option<list<string>>) -> result<list<option<string>>, error>;

    /// The position of each of the members, none for a member that is not in the index.
    ///
    /// GEOPOS key [ member [ member ... ] ]
    /// https://valkey.io/commands/geopos/
    geopos: async func(connection: borrow<connection>, key: string, members: option<list<string>>) -> result<list<option<geo-coordinates>>, error>;

    /// The center of a search, `FROMMEMBER` or `FROMLONLAT`.
    variant geo-from {
        /// `FROMMEMBER member`: the position of a member of the index.
        member(string),
        /// `FROMLONLAT longitude latitude`
        lonlat(geo-coordinates),
    }

    /// `BYRADIUS`: a circle around the center.
    record geo-radius {
        %from: geo-from,
        radius: double,
        unit: geo-unit,
    }

    /// `BYBOX`: a rectangle around the center.
    record geo-box {
        %from: geo-from,
        width: double,
        height: double,
        unit: geo-unit,
    }

    /// The area of a search.
    variant geo-shape {
        /// `[ FROMMEMBER member | FROMLONLAT longitude latitude ] BYRADIUS radius unit`
        radius(geo-radius),
        /// `[ FROMMEMBER member | FROMLONLAT longitude latitude ] BYBOX width height unit`
        box(geo-box),
        /// `BYPOLYGON num-vertices longitude latitude [ longitude latitude ... ]`: the polygon with
        /// the vertices, in order, which has no center.
        polygon(list<geo-coordinates>),
    }

    /// At most a count of the members, `COUNT count [ ANY ]`.
    record geo-count {
        count: integer,
        /// `ANY`: returns as soon as enough members are found, rather than the nearest ones.
        any: bool,
    }

    /// A member a search found, with the details asked for.
    record geo-search-result {
        member: string,
        /// `WITHDIST`: the distance from the center, in the unit of the shape.
        distance: option<double>,
        /// `WITHHASH`: the geohash, as an integer.
        hash: option<integer>,
        /// `WITHCOORD`: the position.
        coordinates: option<geo-coordinates>,
    }

    /// The members of the geospatial index stored at key in the shape.
    ///
    /// See also `geosearch-with`.
    ///
    /// GEOSEARCH key [ FROMMEMBER member | FROMLONLAT longitude latitude ] 〈 BYRADIUS radius 〈 m | km | ft | mi 〉 | BYBOX width height 〈 m | km | ft | mi 〉 | BYPOLYGON num-vertices longitude latitude [ longitude latitude ... ] 〉 [ ASC | DESC ] [ COUNT count [ ANY ] ]
    /// https://valkey.io/commands/geosearch/
    geosearch: async func(connection: borrow<connection>, key: string, shape: geo-shape, order: option<sort-order>, count: option<geo-count>) -> result<list<string>, error>;

    /// The members of the geospatial index stored at key in the shape, with the details asked for.
    ///
    /// See also `geosearch`.
    ///
    /// GEOSEARCH key [ FROMMEMBER member | FROMLONLAT longitude latitude ] 〈 BYRADIUS radius 〈 m | km | ft | mi 〉 | BYBOX width height 〈 m | km | ft | mi 〉 | BYPOLYGON num-vertices longitude latitude [ longitude latitude ... ] 〉 [ ASC | DESC ] [ COUNT count [ ANY ] ] [ WITHCOORD ] [ WITHDIST ] [ WITHHASH ]
    /// https://valkey.io/commands/geosearch/
    geosearch-with: async func(connection: borrow<connection>, key: string, shape: geo-shape, order: option<sort-order>, count: option<geo-count>, withcoord: bool, withdist: bool, withhash: bool) -> result<list<geo-search-result>, error>;

    /// Stores the members of the geospatial index stored at source in the shape, returning how
    /// many, with their positions, or with `storedist`, their distance from the center as the
    /// score.
    ///
    /// GEOSEARCHSTORE destination source [ FROMMEMBER member | FROMLONLAT longitude latitude ] 〈 BYRADIUS radius 〈 m | km | ft | mi 〉 | BYBOX width height 〈 m | km | ft | mi 〉 | BYPOLYGON num-vertices longitude latitude [ longitude latitude ... ] 〉 [ ASC | DESC ] [ COUNT count [ ANY ] ] [ STOREDIST ]
    /// https://valkey.io/commands/geosearchstore/
    geosearchstore: async func(connection: borrow<connection>, destination: string, source: string, shape: geo-shape, order: option<sort-order>, count: option<geo-count>, storedist: bool) -> result<integer, error>;


    // hash commands

    /// Removes the specified fields from the hash stored at key.
    ///
    /// HDEL key field [ field ... ]
    /// https://valkey.io/commands/hdel/
    hdel: async func(connection: borrow<connection>, key: string, fields: list<string>) -> result<integer, error>;

    /// Returns if field is an existing field in the hash stored at key.
    ///
    /// HEXISTS key field
    /// https://valkey.io/commands/hexists/
    hexists: async func(connection: borrow<connection>, key: string, field: string) -> result<bool, error>;

    /// Manipulate the expiration time for existing hash fields.
    ///
    /// HEXPIRE key seconds [ NX | XX | GT | LT ] FIELDS numfields field [ field ... ]
    /// https://valkey.io/commands/hexpire/
    hexpire: async func(connection: borrow<connection>, key: string, seconds: duration-seconds, mode: option<ttl-mode>, fields: list<string>) -> result<list<ttl-result>, error>;

    /// Manipulate the expiration time for existing hash fields.
    ///
    /// HEXPIREAT key unix-time-seconds [ NX | XX | GT | LT ] FIELDS numfields field [ field ... ]
    /// https://valkey.io/commands/hexpireat/
    hexpireat: async func(connection: borrow<connection>, key: string, seconds: unix-time-seconds, mode: option<ttl-mode>, fields: list<string>) -> result<list<ttl-result>, error>;

    /// The remaining time to live of a hash field, to the second, see `httl`.
    variant field-ttl {
        /// -2: the field does not exist, or the hash does not exist.
        does-not-exist,
        /// -1: the field exists, but has no expiration.
        no-expiration,
        /// The time until the field expires.
        expires-in(duration-seconds),
    }

    /// The remaining time to live of a hash field, to the millisecond, see `hpttl`.
    variant field-pttl {
        /// -2: the field does not exist, or the hash does not exist.
        does-not-exist,
        /// -1: the field exists, but has no expiration.
        no-expiration,
        /// The time until the field expires.
        expires-in(duration-milliseconds),
    }

    /// When a hash field expires, to the second, see `hexpiretime`.
    variant field-expiretime {
        /// -2: the field does not exist, or the hash does not exist.
        does-not-exist,
        /// -1: the field exists, but has no expiration.
        no-expiration,
        /// The time at which the field expires.
        expires-at(unix-time-seconds),
    }

    /// When a hash field expires, to the millisecond, see `hpexpiretime`.
    variant field-pexpiretime {
        /// -2: the field does not exist, or the hash does not exist.
        does-not-exist,
        /// -1: the field exists, but has no expiration.
        no-expiration,
        /// The time at which the field expires.
        expires-at(unix-time-milliseconds),
    }

    /// When each of the hash fields expires, to the second.
    ///
    /// See also `hpexpiretime`.
    ///
    /// HEXPIRETIME key FIELDS numfields field [ field ... ]
    /// https://valkey.io/commands/hexpiretime/
    hexpiretime: async func(connection: borrow<connection>, key: string, fields: list<string>) -> result<list<field-expiretime>, error>;

    /// Returns the value associated with field in the hash stored at key.
    ///
    /// HGET key field
    /// https://valkey.io/commands/hget/
    hget: async func(connection: borrow<connection>, key: string, field: string) -> result<option<string>, error>;

    /// Returns all fields and values of the hash stored at key.
    ///
    /// HGETALL key
    /// https://valkey.io/commands/hgetall/
    hgetall: async func(connection: borrow<connection>, key: string) -> result<map<string, string>, error>;

    /// The values of the hash fields, none for a field that does not exist, deleting the fields.
    ///
    /// HGETDEL key FIELDS numfields field [ field ... ]
    /// https://valkey.io/commands/hgetdel/
    hgetdel: async func(connection: borrow<connection>, key: string, fields: list<string>) -> result<list<option<string>>, error>;

    /// The values of the hash fields, none for a field that does not exist, optionally setting or
    /// removing their expiration.
    ///
    /// HGETEX key [ EX seconds | PX milliseconds | EXAT unix-time-seconds | PXAT unix-time-milliseconds | PERSIST ] FIELDS numfields field [ field ... ]
    /// https://valkey.io/commands/hgetex/
    hgetex: async func(connection: borrow<connection>, key: string, ttl: option<getex-ttl>, fields: list<string>) -> result<list<option<string>>, error>;

    /// Increments the number stored at field in the hash stored at key by increment.
    ///
    /// HINCRBY key field increment
    /// https://valkey.io/commands/hincrby/
    hincrby: async func(connection: borrow<connection>, key: string, field: string, increment: integer) -> result<integer, error>;

    /// Increment the specified field of a hash stored at key, and representing a floating point number, by the specified increment.
    ///
    /// HINCRBYFLOAT key field increment
    /// https://valkey.io/commands/hincrbyfloat/
    hincrbyfloat: async func(connection: borrow<connection>, key: string, field: string, increment: double) -> result<double, error>;

    /// Returns all field names in the hash stored at key.
    ///
    /// HKEYS key
    /// https://valkey.io/commands/hkeys/
    hkeys: async func(connection: borrow<connection>, key: string) -> result<list<string>, error>;

    /// Returns the number of fields contained in the hash stored at key.
    ///
    /// HLEN key
    /// https://valkey.io/commands/hlen/
    hlen: async func(connection: borrow<connection>, key: string) -> result<integer, error>;

    /// Returns the values associated with the specified fields in the hash stored at key.
    ///
    /// HMGET key field [ field ... ]
    /// https://valkey.io/commands/hmget/
    hmget: async func(connection: borrow<connection>, key: string, fields: list<string>) -> result<list<option<string>>, error>;

    /// Sets the specified fields to their respective values in the hash stored at key.
    ///
    /// HMSET key field value [ field value ... ]
    /// https://valkey.io/commands/hmset/
    hmset: async func(connection: borrow<connection>, key: string, field-and-values: list<tuple<string, string>>) -> result<_, error>;

    /// The outcome of removing the expiration of a hash field.
    enum field-persist-result {
        /// -2: the field does not exist, or the hash does not exist.
        does-not-exist,
        /// -1: the field exists, but has no expiration.
        no-expiration,
        /// 1: the expiration was removed.
        removed,
    }

    /// Removes the expiration of the hash fields.
    ///
    /// HPERSIST key FIELDS numfields field [ field ... ]
    /// https://valkey.io/commands/hpersist/
    hpersist: async func(connection: borrow<connection>, key: string, fields: list<string>) -> result<list<field-persist-result>, error>;

    /// Manipulate the expiration time for existing hash fields, in milliseconds.
    ///
    /// HPEXPIRE key milliseconds [ NX | XX | GT | LT ] FIELDS numfields field [ field ... ]
    /// https://valkey.io/commands/hpexpire/
    hpexpire: async func(connection: borrow<connection>, key: string, milliseconds: duration-milliseconds, mode: option<ttl-mode>, fields: list<string>) -> result<list<ttl-result>, error>;

    /// Manipulate the expiration time for existing hash fields, as a Unix time in milliseconds.
    ///
    /// HPEXPIREAT key unix-time-milliseconds [ NX | XX | GT | LT ] FIELDS numfields field [ field ... ]
    /// https://valkey.io/commands/hpexpireat/
    hpexpireat: async func(connection: borrow<connection>, key: string, milliseconds: unix-time-milliseconds, mode: option<ttl-mode>, fields: list<string>) -> result<list<ttl-result>, error>;

    /// When each of the hash fields expires, to the millisecond.
    ///
    /// See also `hexpiretime`.
    ///
    /// HPEXPIRETIME key FIELDS numfields field [ field ... ]
    /// https://valkey.io/commands/hpexpiretime/
    hpexpiretime: async func(connection: borrow<connection>, key: string, fields: list<string>) -> result<list<field-pexpiretime>, error>;

    /// The remaining time to live of each of the hash fields, to the millisecond.
    ///
    /// See also `httl`.
    ///
    /// HPTTL key FIELDS numfields field [ field ... ]
    /// https://valkey.io/commands/hpttl/
    hpttl: async func(connection: borrow<connection>, key: string, fields: list<string>) -> result<list<field-pttl>, error>;

    /// Random fields from the hash value stored at key, up to the count.
    ///
    /// Without a count, one field, or none when the key does not exist. A negative count may return
    /// the same field more than once, its absolute value is the number of fields returned.
    ///
    /// Also see `hrandfield-withvalues`.
    ///
    /// HRANDFIELD key [ count ]
    /// https://valkey.io/commands/hrandfield/
    hrandfield: async func(connection: borrow<connection>, key: string, count: option<integer>) -> result<list<string>, error>;

    /// Random fields and their values from the hash value stored at key, up to the count.
    ///
    /// A negative count may return the same field more than once, its absolute value is the number of
    /// fields returned.
    ///
    /// Also see `hrandfield`.
    ///
    /// HRANDFIELD key count WITHVALUES
    /// https://valkey.io/commands/hrandfield/
    hrandfield-withvalues: async func(connection: borrow<connection>, key: string, count: integer) -> result<list<tuple<string, string>>, error>;

    /// Incrementally iterate over a collection of elements.
    ///
    /// See also `hscan-novalues`.
    ///
    /// HSCAN key cursor [ MATCH pattern ] [ COUNT count ]
    /// https://valkey.io/commands/hscan/
    hscan: async func(connection: borrow<connection>, key: string, cursor: cursor, match: option<string>, count: option<integer>) -> result<tuple<option<cursor>, map<string, string>>, error>;

    /// Incrementally iterate over a collection of keys.
    ///
    /// See also `hscan`.
    ///
    /// HSCAN key cursor [ MATCH pattern ] [ COUNT count ] NOVALUES
    /// https://valkey.io/commands/hscan/
    hscan-novalues: async func(connection: borrow<connection>, key: string, cursor: cursor, match: option<string>, count: option<integer>) -> result<tuple<option<cursor>, list<string>>, error>;

    /// Sets the specified fields to their respective values in the hash stored at key.
    ///
    /// HSET key field value [ field value ... ]
    /// https://valkey.io/commands/hset/
    hset: async func(connection: borrow<connection>, key: string, field-and-values: list<tuple<string, string>>) -> result<integer, error>;

    /// Only set the fields when the hash does, or does not, exist, HSETEX's `NX` and `XX`.
    enum hsetex-condition {
        /// Only set the fields when the hash does not exist.
        nx,
        /// Only set the fields when the hash exists.
        xx,
    }

    /// Only set the fields when none, or all, of them exist, HSETEX's `FNX` and `FXX`.
    enum hsetex-field-condition {
        /// Only set the fields when none of them exist.
        fnx,
        /// Only set the fields when all of them exist.
        fxx,
    }

    /// Sets the fields to their values in the hash stored at key, optionally setting their
    /// expiration, returning whether they were set, false when a condition prevented it.
    ///
    /// HSETEX key [ NX | XX ] [ FNX | FXX ] [ EX seconds | PX milliseconds | EXAT unix-time-seconds | PXAT unix-time-milliseconds | KEEPTTL ] FIELDS numfields field value [ field value ... ]
    /// https://valkey.io/commands/hsetex/
    hsetex: async func(connection: borrow<connection>, key: string, condition: option<hsetex-condition>, field-condition: option<hsetex-field-condition>, ttl: option<set-ttl>, field-and-values: list<tuple<string, string>>) -> result<bool, error>;

    /// Sets field in the hash stored at key to value, only if field does not yet exist.
    ///
    /// HSETNX key field value
    /// https://valkey.io/commands/hsetnx/
    hsetnx: async func(connection: borrow<connection>, key: string, field: string, value: string) -> result<bool, error>;

    /// Returns the string length of the value associated with field in the hash stored at key.
    ///
    /// HSTRLEN key field
    /// https://valkey.io/commands/hstrlen/
    hstrlen: async func(connection: borrow<connection>, key: string, field: string) -> result<integer, error>;

    /// The remaining time to live of each of the hash fields, to the second.
    ///
    /// See also `hpttl`.
    ///
    /// HTTL key FIELDS numfields field [ field ... ]
    /// https://valkey.io/commands/httl/
    httl: async func(connection: borrow<connection>, key: string, fields: list<string>) -> result<list<field-ttl>, error>;

    /// All values in the hash stored at key.
    ///
    /// HVALS key
    /// https://valkey.io/commands/hvals/
    hvals: async func(connection: borrow<connection>, key: string) -> result<list<string>, error>;


    // hyperloglog commands

    /// Adds the elements to the HyperLogLog stored at key, creating it when it does not exist,
    /// returning whether its estimate may have changed.
    ///
    /// Without elements, creates an empty HyperLogLog, true only when the key did not exist.
    ///
    /// PFADD key [ element [ element ... ] ]
    /// https://valkey.io/commands/pfadd/
    pfadd: async func(connection: borrow<connection>, key: string, elements: option<list<string>>) -> result<bool, error>;

    /// The approximate number of unique elements added to the HyperLogLogs, of their union for
    /// more than one, 0 for a key that does not exist.
    ///
    /// PFCOUNT key [ key ... ]
    /// https://valkey.io/commands/pfcount/
    pfcount: async func(connection: borrow<connection>, keys: list<string>) -> result<integer, error>;

    /// Merges the HyperLogLogs stored at the source keys into the one stored at destination,
    /// creating it when it does not exist.
    ///
    /// Without source keys, creates an empty HyperLogLog when destination does not exist.
    ///
    /// PFMERGE destkey [ sourcekey [ sourcekey ... ] ]
    /// https://valkey.io/commands/pfmerge/
    pfmerge: async func(connection: borrow<connection>, destination: string, sources: option<list<string>>) -> result<_, error>;

    // PFDEBUG and PFSELFTEST are internal commands, for debugging and testing Valkey itself, and
    // are not implemented


    // keyspace commands

    /// Removes the specified keys.
    ///
    /// DEL key [ key ... ]
    /// https://valkey.io/commands/del/
    del: async func(connection: borrow<connection>, keys: list<string>) -> result<integer, error>;

    /// If key exists.
    ///
    /// EXISTS key [ key ... ]
    /// https://valkey.io/commands/exists/
    exists: async func(connection: borrow<connection>, keys: list<string>) -> result<integer, error>;

    /// Set a timeout on key.
    ///
    /// EXPIRE key seconds [ NX | XX | GT | LT ]
    /// https://valkey.io/commands/expire/
    expire: async func(connection: borrow<connection>, key: string, seconds: duration-seconds, mode: option<ttl-mode>) -> result<bool, error>;

    /// Set a timeout on key.
    ///
    /// EXPIREAT key unix-time-seconds [ NX | XX | GT | LT ]
    /// https://valkey.io/commands/expireat/
    expireat: async func(connection: borrow<connection>, key: string, seconds: unix-time-seconds, mode: option<ttl-mode>) -> result<bool, error>;

    /// Returns all keys matching pattern.
    ///
    /// KEYS pattern
    /// https://valkey.io/commands/keys/
    keys: async func(connection: borrow<connection>, pattern: string) -> result<list<string>, error>;

    // not yet implemented, from the @keyspace category:
    //   CLUSTERSCAN
    //   CLUSTER FLUSHSLOT
    //   COPY
    //   DBSIZE
    //   DUMP, needs binary support, the payload is not a string
    //   EXPIRETIME
    //   FLUSHALL
    //   FLUSHDB
    //   MIGRATE
    //   MOVE
    //   OBJECT ENCODING
    //   OBJECT FREQ
    //   OBJECT IDLETIME
    //   OBJECT REFCOUNT
    //   PERSIST
    //   PEXPIRE
    //   PEXPIREAT
    //   PEXPIRETIME
    //   PTTL
    //   RANDOMKEY
    //   RENAME
    //   RENAMENX
    //   RESTORE, needs binary support, the payload is not a string
    //   RESTORE-ASKING, needs binary support, the payload is not a string
    //   SCAN
    //   SWAPDB
    //   TOUCH
    //   TTL
    //   TYPE
    //   UNLINK


    // list commands

    /// An end of a list.
    enum list-side {
        /// `LEFT`: the head, the first element.
        left,
        /// `RIGHT`: the tail, the last element.
        right,
    }

    /// Where LINSERT inserts an element, relative to the pivot.
    enum linsert-position {
        /// `BEFORE`: in front of the pivot.
        before,
        /// `AFTER`: behind the pivot.
        after,
    }

    /// The outcome of LINSERT.
    variant linsert-result {
        /// The element was inserted, the length of the list after it.
        inserted(integer),
        /// 0: the key does not exist, nothing was inserted.
        no-such-key,
        /// -1: the pivot is not in the list, nothing was inserted.
        pivot-not-found,
    }

    /// Moves an element from one end of the source list to an end of the destination list, waiting
    /// up to the timeout for the source to have one, returning it.
    ///
    /// Returns none when the timeout passed. A timeout of zero waits indefinitely.
    ///
    /// The connection waits too, replies to commands sent after it on the connection wait behind
    /// it. Use a connection of your own.
    ///
    /// BLMOVE source destination 〈 LEFT | RIGHT 〉 〈 LEFT | RIGHT 〉 timeout
    /// https://valkey.io/commands/blmove/
    blmove: async func(connection: borrow<connection>, source: string, destination: string, wherefrom: list-side, whereto: list-side, timeout: duration-milliseconds) -> result<option<string>, error>;

    /// Removes elements from an end of the first non-empty list, waiting up to the timeout for one,
    /// returning its key and the elements, one without a count.
    ///
    /// Returns none when the timeout passed. A timeout of zero waits indefinitely.
    ///
    /// The connection waits too, replies to commands sent after it on the connection wait behind
    /// it. Use a connection of your own.
    ///
    /// BLMPOP timeout numkeys key [ key ... ] 〈 LEFT | RIGHT 〉 [ COUNT count ]
    /// https://valkey.io/commands/blmpop/
    blmpop: async func(connection: borrow<connection>, timeout: duration-milliseconds, keys: list<string>, end: list-side, count: option<integer>) -> result<option<tuple<string, list<string>>>, error>;

    /// Removes the first element of the first non-empty list, waiting up to the timeout for one,
    /// returning its key and the element.
    ///
    /// Returns none when the timeout passed. A timeout of zero waits indefinitely.
    ///
    /// The connection waits too, replies to commands sent after it on the connection wait behind
    /// it. Use a connection of your own.
    ///
    /// BLPOP key [ key ... ] timeout
    /// https://valkey.io/commands/blpop/
    blpop: async func(connection: borrow<connection>, keys: list<string>, timeout: duration-milliseconds) -> result<option<tuple<string, string>>, error>;

    /// Removes the last element of the first non-empty list, waiting up to the timeout for one,
    /// returning its key and the element.
    ///
    /// Returns none when the timeout passed. A timeout of zero waits indefinitely.
    ///
    /// The connection waits too, replies to commands sent after it on the connection wait behind
    /// it. Use a connection of your own.
    ///
    /// BRPOP key [ key ... ] timeout
    /// https://valkey.io/commands/brpop/
    brpop: async func(connection: borrow<connection>, keys: list<string>, timeout: duration-milliseconds) -> result<option<tuple<string, string>>, error>;

    /// Moves the last element of the source list to the head of the destination list, waiting up
    /// to the timeout for the source to have one, returning it.
    ///
    /// Returns none when the timeout passed. A timeout of zero waits indefinitely.
    ///
    /// The connection waits too, replies to commands sent after it on the connection wait behind
    /// it. Use a connection of your own.
    ///
    /// See also `blmove`.
    ///
    /// BRPOPLPUSH source destination timeout
    /// https://valkey.io/commands/brpoplpush/
    brpoplpush: async func(connection: borrow<connection>, source: string, destination: string, timeout: duration-milliseconds) -> result<option<string>, error>;

    /// The element at the index of the list stored at key, negative from the end, none when the
    /// index is out of range.
    ///
    /// LINDEX key index
    /// https://valkey.io/commands/lindex/
    lindex: async func(connection: borrow<connection>, key: string, index: integer) -> result<option<string>, error>;

    /// Inserts the element before or after the first occurrence of the pivot in the list stored at
    /// key.
    ///
    /// LINSERT key 〈 BEFORE | AFTER 〉 pivot element
    /// https://valkey.io/commands/linsert/
    linsert: async func(connection: borrow<connection>, key: string, position: linsert-position, pivot: string, element: string) -> result<linsert-result, error>;

    /// The length of the list stored at key, 0 when the key does not exist.
    ///
    /// LLEN key
    /// https://valkey.io/commands/llen/
    llen: async func(connection: borrow<connection>, key: string) -> result<integer, error>;

    /// Moves an element from one end of the source list to an end of the destination list,
    /// returning it, none when the source does not exist.
    ///
    /// LMOVE source destination 〈 LEFT | RIGHT 〉 〈 LEFT | RIGHT 〉
    /// https://valkey.io/commands/lmove/
    lmove: async func(connection: borrow<connection>, source: string, destination: string, wherefrom: list-side, whereto: list-side) -> result<option<string>, error>;

    /// Removes elements from an end of the first non-empty list, returning its key and the
    /// elements, one without a count, none when every list is empty.
    ///
    /// LMPOP numkeys key [ key ... ] 〈 LEFT | RIGHT 〉 [ COUNT count ]
    /// https://valkey.io/commands/lmpop/
    lmpop: async func(connection: borrow<connection>, keys: list<string>, end: list-side, count: option<integer>) -> result<option<tuple<string, list<string>>>, error>;

    /// Removes and returns the first elements of the list stored at key, up to the count, one
    /// without a count, none when the key does not exist.
    ///
    /// LPOP key [ count ]
    /// https://valkey.io/commands/lpop/
    lpop: async func(connection: borrow<connection>, key: string, count: option<integer>) -> result<list<string>, error>;

    /// The positions of the element in the list stored at key, up to the count, 0 for every match,
    /// the first match without a count.
    ///
    /// The rank skips matches, the second match for 2, counting from the end when negative. The
    /// max length limits how many elements are compared.
    ///
    /// LPOS key element [ RANK rank ] [ COUNT num-matches ] [ MAXLEN len ]
    /// https://valkey.io/commands/lpos/
    lpos: async func(connection: borrow<connection>, key: string, element: string, rank: option<integer>, count: option<integer>, maxlen: option<integer>) -> result<list<integer>, error>;

    /// Inserts the elements at the head of the list stored at key, creating it when it does not
    /// exist, returning its length after.
    ///
    /// LPUSH key element [ element ... ]
    /// https://valkey.io/commands/lpush/
    lpush: async func(connection: borrow<connection>, key: string, elements: list<string>) -> result<integer, error>;

    /// Inserts the elements at the head of the list stored at key, only when it exists, returning
    /// its length after, 0 when it does not exist.
    ///
    /// LPUSHX key element [ element ... ]
    /// https://valkey.io/commands/lpushx/
    lpushx: async func(connection: borrow<connection>, key: string, elements: list<string>) -> result<integer, error>;

    /// The elements of the list stored at key from the start to the stop, both included, negative
    /// from the end.
    ///
    /// LRANGE key start stop
    /// https://valkey.io/commands/lrange/
    lrange: async func(connection: borrow<connection>, key: string, start: integer, stop: integer) -> result<list<string>, error>;

    /// Removes occurrences of the element from the list stored at key, returning how many.
    ///
    /// A positive count removes up to that many from the head, a negative count from the tail, and
    /// 0 removes them all.
    ///
    /// LREM key count element
    /// https://valkey.io/commands/lrem/
    lrem: async func(connection: borrow<connection>, key: string, count: integer, element: string) -> result<integer, error>;

    /// Sets the element at the index of the list stored at key, negative from the end.
    ///
    /// LSET key index element
    /// https://valkey.io/commands/lset/
    lset: async func(connection: borrow<connection>, key: string, index: integer, element: string) -> result<_, error>;

    /// Trims the list stored at key to the elements from the start to the stop, both included,
    /// negative from the end.
    ///
    /// LTRIM key start stop
    /// https://valkey.io/commands/ltrim/
    ltrim: async func(connection: borrow<connection>, key: string, start: integer, stop: integer) -> result<_, error>;

    /// Removes and returns the last elements of the list stored at key, up to the count, one
    /// without a count, none when the key does not exist.
    ///
    /// RPOP key [ count ]
    /// https://valkey.io/commands/rpop/
    rpop: async func(connection: borrow<connection>, key: string, count: option<integer>) -> result<list<string>, error>;

    /// Moves the last element of the source list to the head of the destination list, returning
    /// it, none when the source does not exist.
    ///
    /// See also `lmove`.
    ///
    /// RPOPLPUSH source destination
    /// https://valkey.io/commands/rpoplpush/
    rpoplpush: async func(connection: borrow<connection>, source: string, destination: string) -> result<option<string>, error>;

    /// Inserts the elements at the tail of the list stored at key, creating it when it does not
    /// exist, returning its length after.
    ///
    /// RPUSH key element [ element ... ]
    /// https://valkey.io/commands/rpush/
    rpush: async func(connection: borrow<connection>, key: string, elements: list<string>) -> result<integer, error>;

    /// Inserts the elements at the tail of the list stored at key, only when it exists, returning
    /// its length after, 0 when it does not exist.
    ///
    /// RPUSHX key element [ element ... ]
    /// https://valkey.io/commands/rpushx/
    rpushx: async func(connection: borrow<connection>, key: string, elements: list<string>) -> result<integer, error>;


    // pubsub commands

    /// Subscribes the client to the given patterns.
    ///
    /// PSUBSCRIBE pattern [ pattern ... ]
    /// https://valkey.io/commands/psubscribe/
    psubscribe: async func(connection: borrow<connection>, patterns: list<string>) -> result<_, error>;

    /// Posts a message to the given channel.
    ///
    /// PUBLISH channel message
    /// https://valkey.io/commands/publish/
    publish: async func(connection: borrow<connection>, channel: string, message: string) -> result<integer, error>;

    /// Lists the currently active channels.
    ///
    /// PUBSUB CHANNELS [ pattern ]
    /// https://valkey.io/commands/pubsub-channels/
    pubsub-channels: async func(connection: borrow<connection>, pattern: option<string>) -> result<list<string>, error>;

    /// Returns the number of unique patterns that are subscribed to by clients.
    ///
    /// PUBSUB NUMPAT
    /// https://valkey.io/commands/pubsub-numpat/
    pubsub-numpat: async func(connection: borrow<connection>) -> result<integer, error>;

    /// Returns the number of subscribers (exclusive of clients subscribed to patterns) for the specified channels.
    ///
    /// PUBSUB NUMSUB [ channel ] [ [ channel ] ... ]
    /// https://valkey.io/commands/pubsub-numsub/
    pubsub-numsub: async func(connection: borrow<connection>, channels: option<list<string>>) -> result<map<string, integer>, error>;

    /// Lists the currently active shard channels.
    ///
    /// PUBSUB SHARDCHANNELS [ pattern ]
    /// https://valkey.io/commands/pubsub-shardchannels/
    pubsub-shardchannels: async func(connection: borrow<connection>, pattern: option<string>) -> result<list<string>, error>;

    /// Returns the number of subscribers for the specified shard channels.
    ///
    /// PUBSUB SHARDNUMSUB [ shardchannel [ shardchannel ... ] ]
    /// https://valkey.io/commands/pubsub-shardnumsub/
    pubsub-shardnumsub: async func(connection: borrow<connection>, shardchannels: option<list<string>>) -> result<map<string, integer>, error>;

    /// Unsubscribes the client from the given patterns, or from all of them if none is given.
    ///
    /// PUNSUBSCRIBE [ pattern [ pattern ... ] ]
    /// https://valkey.io/commands/punsubscribe/
    punsubscribe: async func(connection: borrow<connection>, patterns: option<list<string>>) -> result<_, error>;

    /// Posts a message to the given shard channel.
    ///
    /// SPUBLISH shardchannel message
    /// https://valkey.io/commands/spublish/
    spublish: async func(connection: borrow<connection>, shardchannel: string, message: string) -> result<integer, error>;

    /// Subscribes the client to the specified shard channels.
    ///
    /// SSUBSCRIBE shardchannel [ shardchannel ... ]
    /// https://valkey.io/commands/ssubscribe/
    ssubscribe: async func(connection: borrow<connection>, shardchannels: list<string>) -> result<_, error>;

    /// Subscribes the client to the specified channels.
    ///
    /// SUBSCRIBE channel [ channel ... ]
    /// https://valkey.io/commands/subscribe/
    subscribe: async func(connection: borrow<connection>, channels: list<string>) -> result<_, error>;

    /// Unsubscribes the client from the given shard channels, or from all of them if none is given.
    ///
    /// SUNSUBSCRIBE [ shardchannel ] [ [ shardchannel ] ... ]
    /// https://valkey.io/commands/sunsubscribe/
    sunsubscribe: async func(connection: borrow<connection>, shardchannels: option<list<string>>) -> result<_, error>;

    /// Unsubscribes the client from the given channels, or from all of them if none is given.
    ///
    /// UNSUBSCRIBE [ channel ] [ [ channel ] ... ]
    /// https://valkey.io/commands/unsubscribe/
    unsubscribe: async func(connection: borrow<connection>, channels: option<list<string>>) -> result<_, error>;


    // scripting commands

    /// Runs the Lua script, returning its result, the keys it accesses and its arguments are
    /// `KEYS` and `ARGV` in the script.
    ///
    /// An error the script returns fails the call.
    ///
    /// EVAL script numkeys [ key [ key ... ] ] [ arg [ arg ... ] ]
    /// https://valkey.io/commands/eval/
    eval: async func(connection: borrow<connection>, script: string, keys: option<list<string>>, args: option<list<string>>) -> result<value, error>;

    /// Runs the Lua script, which may not write, returning its result, see `eval`.
    ///
    /// EVAL_RO script numkeys [ key [ key ... ] ] [ arg [ arg ... ] ]
    /// https://valkey.io/commands/eval_ro/
    eval-ro: async func(connection: borrow<connection>, script: string, keys: option<list<string>>, args: option<list<string>>) -> result<value, error>;

    /// Runs the Lua script cached with the SHA1 digest, see `script-load`, returning its result, see
    /// `eval`.
    ///
    /// EVALSHA sha1 numkeys [ key [ key ... ] ] [ arg [ arg ... ] ]
    /// https://valkey.io/commands/evalsha/
    evalsha: async func(connection: borrow<connection>, sha1: string, keys: option<list<string>>, args: option<list<string>>) -> result<value, error>;

    /// Runs the Lua script cached with the SHA1 digest, which may not write, returning its result,
    /// see `eval`.
    ///
    /// EVALSHA_RO sha1 numkeys [ key [ key ... ] ] [ arg [ arg ... ] ]
    /// https://valkey.io/commands/evalsha_ro/
    evalsha-ro: async func(connection: borrow<connection>, sha1: string, keys: option<list<string>>, args: option<list<string>>) -> result<value, error>;

    /// Calls the function, see `function-load`, returning its result, the keys it accesses and its
    /// arguments are passed to it.
    ///
    /// An error the function returns fails the call.
    ///
    /// FCALL function numkeys [ key [ key ... ] ] [ arg [ arg ... ] ]
    /// https://valkey.io/commands/fcall/
    fcall: async func(connection: borrow<connection>, function: string, keys: option<list<string>>, args: option<list<string>>) -> result<value, error>;

    /// Calls the function, which must be flagged `no-writes`, returning its result, see `fcall`.
    ///
    /// FCALL_RO function numkeys [ key [ key ... ] ] [ arg [ arg ... ] ]
    /// https://valkey.io/commands/fcall_ro/
    fcall-ro: async func(connection: borrow<connection>, function: string, keys: option<list<string>>, args: option<list<string>>) -> result<value, error>;

    /// Deletes the library and its functions.
    ///
    /// FUNCTION DELETE library-name
    /// https://valkey.io/commands/function-delete/
    function-delete: async func(connection: borrow<connection>, library-name: string) -> result<_, error>;

    /// Whether a flush happens in the background, `ASYNC`, or before replying, `SYNC`.
    enum flush-mode {
        /// `ASYNC`
        %async,
        /// `SYNC`
        sync,
    }

    /// Deletes all the libraries, in the mode, the server's `lazyfree-lazy-user-flush` without one.
    ///
    /// FUNCTION FLUSH [ ASYNC | SYNC ]
    /// https://valkey.io/commands/function-flush/
    function-flush: async func(connection: borrow<connection>, mode: option<flush-mode>) -> result<_, error>;

    /// Kills the function that is running, as long as it has not written.
    ///
    /// FUNCTION KILL
    /// https://valkey.io/commands/function-kill/
    function-kill: async func(connection: borrow<connection>) -> result<_, error>;

    /// A function of a library.
    record library-function {
        name: string,
        description: option<string>,
        /// The function's flags, e.g. `no-writes`.
        %flags: list<string>,
    }

    /// A library of functions.
    record library {
        library-name: string,
        /// The engine that runs the library, e.g. `LUA`.
        engine: string,
        functions: list<library-function>,
        /// The library's source code, with `withcode`.
        library-code: option<string>,
    }

    /// The libraries, those with names matching the glob-style pattern with one.
    ///
    /// FUNCTION LIST [ LIBRARYNAME library-name-pattern ] [ WITHCODE ]
    /// https://valkey.io/commands/function-list/
    function-list: async func(connection: borrow<connection>, library-name-pattern: option<string>, withcode: bool) -> result<list<library>, error>;

    /// Loads the library from its source code, replacing a library of the same name with
    /// `replace`, returning its name.
    ///
    /// FUNCTION LOAD [ REPLACE ] function-code
    /// https://valkey.io/commands/function-load/
    function-load: async func(connection: borrow<connection>, replace: bool, function-code: string) -> result<string, error>;

    /// The function that is running.
    record running-function {
        name: string,
        /// The command and its arguments that called the function.
        command: list<string>,
        /// How long the function has been running.
        duration: duration-milliseconds,
    }

    /// The libraries and functions of an engine.
    record engine-stats {
        libraries-count: integer,
        functions-count: integer,
    }

    /// The function that is running, and the libraries and functions of each engine.
    record function-stats-reply {
        /// None when no function is running.
        running-script: option<running-function>,
        /// The statistics of each engine, by name.
        engines: map<string, engine-stats>,
    }

    /// The function that is running, and the libraries and functions of each engine.
    ///
    /// FUNCTION STATS
    /// https://valkey.io/commands/function-stats/
    function-stats: async func(connection: borrow<connection>) -> result<function-stats-reply, error>;

    /// Whether each of the scripts is cached, by SHA1 digest.
    ///
    /// SCRIPT EXISTS sha1 [ sha1 ... ]
    /// https://valkey.io/commands/script-exists/
    script-exists: async func(connection: borrow<connection>, sha1s: list<string>) -> result<list<bool>, error>;

    /// Removes all the scripts from the cache, in the mode, the server's `lazyfree-lazy-user-flush`
    /// without one.
    ///
    /// SCRIPT FLUSH [ ASYNC | SYNC ]
    /// https://valkey.io/commands/script-flush/
    script-flush: async func(connection: borrow<connection>, mode: option<flush-mode>) -> result<_, error>;

    /// Kills the script that is running, as long as it has not written.
    ///
    /// SCRIPT KILL
    /// https://valkey.io/commands/script-kill/
    script-kill: async func(connection: borrow<connection>) -> result<_, error>;

    /// Caches the script without running it, returning its SHA1 digest, see `evalsha`.
    ///
    /// SCRIPT LOAD script
    /// https://valkey.io/commands/script-load/
    script-load: async func(connection: borrow<connection>, script: string) -> result<string, error>;

    /// The source of the cached script with the SHA1 digest.
    ///
    /// SCRIPT SHOW sha1
    /// https://valkey.io/commands/script-show/
    script-show: async func(connection: borrow<connection>, sha1: string) -> result<string, error>;

    // not implemented, from the @scripting category:
    //   FUNCTION DUMP and FUNCTION RESTORE, the payload is binary, not a string
    //   SCRIPT DEBUG, the debugger is interactive, with a protocol of its own



    // set commands

    /// Adds the members to the set stored at key, returning how many were not already members.
    ///
    /// SADD key member [ member ... ]
    /// https://valkey.io/commands/sadd/
    sadd: async func(connection: borrow<connection>, key: string, members: list<string>) -> result<integer, error>;

    /// The number of members in the set stored at key.
    ///
    /// SCARD key
    /// https://valkey.io/commands/scard/
    scard: async func(connection: borrow<connection>, key: string) -> result<integer, error>;

    /// The members of the first set that are not in any of the others.
    ///
    /// SDIFF key [ key ... ]
    /// https://valkey.io/commands/sdiff/
    sdiff: async func(connection: borrow<connection>, keys: list<string>) -> result<list<string>, error>;

    /// Stores the members of the first set that are not in any of the others, returning how many.
    ///
    /// SDIFFSTORE destination key [ key ... ]
    /// https://valkey.io/commands/sdiffstore/
    sdiffstore: async func(connection: borrow<connection>, destination: string, keys: list<string>) -> result<integer, error>;

    /// The members in all of the sets.
    ///
    /// SINTER key [ key ... ]
    /// https://valkey.io/commands/sinter/
    sinter: async func(connection: borrow<connection>, keys: list<string>) -> result<list<string>, error>;

    /// The number of members in all of the sets, counting stops at the limit.
    ///
    /// SINTERCARD numkeys key [ key ... ] [ LIMIT limit ]
    /// https://valkey.io/commands/sintercard/
    sintercard: async func(connection: borrow<connection>, keys: list<string>, limit: option<integer>) -> result<integer, error>;

    /// Stores the members in all of the sets, returning how many.
    ///
    /// SINTERSTORE destination key [ key ... ]
    /// https://valkey.io/commands/sinterstore/
    sinterstore: async func(connection: borrow<connection>, destination: string, keys: list<string>) -> result<integer, error>;

    /// Whether the member is in the set stored at key, false when the key does not exist.
    ///
    /// See also `sismember-xx`.
    ///
    /// SISMEMBER key member
    /// https://valkey.io/commands/sismember/
    sismember: async func(connection: borrow<connection>, key: string, member: string) -> result<bool, error>;

    /// Whether the member is in the set stored at key, none when the key does not exist.
    ///
    /// See also `sismember`.
    ///
    /// SISMEMBER key member XX
    /// https://valkey.io/commands/sismember/
    sismember-xx: async func(connection: borrow<connection>, key: string, member: string) -> result<option<bool>, error>;

    /// The members of the set stored at key.
    ///
    /// SMEMBERS key
    /// https://valkey.io/commands/smembers/
    smembers: async func(connection: borrow<connection>, key: string) -> result<list<string>, error>;

    /// Whether each of the members is in the set stored at key.
    ///
    /// SMISMEMBER key member [ member ... ]
    /// https://valkey.io/commands/smismember/
    smismember: async func(connection: borrow<connection>, key: string, members: list<string>) -> result<list<bool>, error>;

    /// Moves the member from one set to another, false when it was not in the source set.
    ///
    /// SMOVE source destination member
    /// https://valkey.io/commands/smove/
    smove: async func(connection: borrow<connection>, source: string, destination: string, member: string) -> result<bool, error>;

    /// Removes and returns random members of the set stored at key, up to the count.
    ///
    /// Without a count, one member, or none when the key does not exist.
    ///
    /// SPOP key [ count ]
    /// https://valkey.io/commands/spop/
    spop: async func(connection: borrow<connection>, key: string, count: option<integer>) -> result<list<string>, error>;

    /// Random members of the set stored at key, up to the count.
    ///
    /// Without a count, one member, or none when the key does not exist. A negative count may return
    /// the same member more than once, its absolute value is the number of members returned.
    ///
    /// SRANDMEMBER key [ count ]
    /// https://valkey.io/commands/srandmember/
    srandmember: async func(connection: borrow<connection>, key: string, count: option<integer>) -> result<list<string>, error>;

    /// Removes the members from the set stored at key, returning how many were members.
    ///
    /// SREM key member [ member ... ]
    /// https://valkey.io/commands/srem/
    srem: async func(connection: borrow<connection>, key: string, members: list<string>) -> result<integer, error>;

    /// Incrementally iterate over the members of the set stored at key.
    ///
    /// SSCAN key cursor [ MATCH pattern ] [ COUNT count ]
    /// https://valkey.io/commands/sscan/
    sscan: async func(connection: borrow<connection>, key: string, cursor: cursor, match: option<string>, count: option<integer>) -> result<tuple<option<cursor>, list<string>>, error>;

    /// The members in any of the sets.
    ///
    /// SUNION key [ key ... ]
    /// https://valkey.io/commands/sunion/
    sunion: async func(connection: borrow<connection>, keys: list<string>) -> result<list<string>, error>;

    /// Stores the members in any of the sets, returning how many.
    ///
    /// SUNIONSTORE destination key [ key ... ]
    /// https://valkey.io/commands/sunionstore/
    sunionstore: async func(connection: borrow<connection>, destination: string, keys: list<string>) -> result<integer, error>;

    /// A range of a sorted result, `LIMIT offset count`.
    record limit {
        /// The number of elements skipped.
        offset: integer,
        /// The maximum number of elements returned, negative for all of them.
        count: integer,
    }

    /// How SORT orders and projects the elements of a list, set or sorted set.
    record sort-opts {
        /// `BY pattern`: sorts by the values of the keys the pattern names, `*` replaced with each
        /// element, or `nosort` to skip sorting.
        by: option<string>,
        /// `LIMIT offset count`: a range of the sorted elements.
        limit: option<limit>,
        /// `GET pattern`: returns the values of the keys each pattern names instead of the elements,
        /// `#` for the element itself.
        get: option<list<string>>,
        /// order to sort elements.
        order: option<sort-order>,
        /// `ALPHA`: sorts lexicographically, rather than numerically.
        alpha: bool,
    }

    enum sort-order {
        /// ascending, smallest to largest.
        asc,
        /// descending, largest to smallest.
        desc,
    }

    /// Sorts the elements of the list, set or sorted set stored at key.
    ///
    /// Each row is the element, or with `get`, the value of each pattern, none when its key does not
    /// exist.
    ///
    /// SORT key [ BY pattern ] [ LIMIT offset count ] [ GET pattern ... ] [ ASC | DESC ] [ ALPHA ]
    /// https://valkey.io/commands/sort/
    sort: async func(connection: borrow<connection>, key: string, opts: option<sort-opts>) -> result<list<list<option<string>>>, error>;

    /// Sorts the elements of the list, set or sorted set stored at key, storing them as a list,
    /// returning how many.
    ///
    /// SORT key [ BY pattern ] [ LIMIT offset count ] [ GET pattern ... ] [ ASC | DESC ] [ ALPHA ] STORE destination
    /// https://valkey.io/commands/sort/
    sort-store: async func(connection: borrow<connection>, key: string, opts: option<sort-opts>, destination: string) -> result<integer, error>;

    /// The read-only variant of `sort`, e.g. for replicas.
    ///
    /// SORT_RO key [ BY pattern ] [ LIMIT offset count ] [ GET pattern ... ] [ ASC | DESC ] [ ALPHA ]
    /// https://valkey.io/commands/sort_ro/
    sort-ro: async func(connection: borrow<connection>, key: string, opts: option<sort-opts>) -> result<list<list<option<string>>>, error>;


    // sortedset commands

    /// A bound of a range of scores.
    variant score-bound {
        /// The score, included in the range.
        inclusive(double),
        /// `(score`: the score, excluded from the range.
        exclusive(double),
        /// `-inf` as the min, `+inf` as the max, the start is the max with `REV`.
        unbounded,
    }

    /// A bound of a range of members, for members of equal score, ordered lexicographically.
    variant lex-bound {
        /// `[member`: the member, included in the range.
        inclusive(string),
        /// `(member`: the member, excluded from the range.
        exclusive(string),
        /// `-` as the min, `+` as the max, the start is the max with `REV`.
        unbounded,
    }

    /// Which end of a sorted set to pop from.
    enum pop-end {
        /// The members with the lowest scores.
        min,
        /// The members with the highest scores.
        max,
    }

    /// How scores combine for a member in several sorted sets.
    enum aggregate {
        /// The sum of the weighted scores, the default.
        sum,
        /// The lowest weighted score.
        min,
        /// The highest weighted score.
        max,
    }

    /// The range of ZRANGE and ZRANGESTORE, `start` and `stop`, given as they are sent: with `REV`,
    /// the higher bound first.
    variant zrange-by {
        /// Positions, both included, negative from the end.
        rank(tuple<integer, integer>),
        /// `BYSCORE`: the members with scores in the range.
        score(tuple<score-bound, score-bound>),
        /// `BYLEX`: the members in the range, for members of equal score.
        lex(tuple<lex-bound, lex-bound>),
    }

    /// The range of ZRANGE WITHSCORES, which does not support BYLEX, see `zrange-by`.
    variant zrange-withscores-by {
        /// Positions, both included, negative from the end.
        rank(tuple<integer, integer>),
        /// `BYSCORE`: the members with scores in the range.
        score(tuple<score-bound, score-bound>),
    }

    /// Only update or only add members, ZADD's `NX` and `XX`.
    enum zadd-condition {
        /// Only add new members, never update existing ones.
        nx,
        /// Only update existing members, never add new ones.
        xx,
    }

    /// Only update a member's score when the new score is greater or less, ZADD's `GT` and `LT`.
    enum zadd-comparison {
        /// Only update when the new score is greater than the current one.
        gt,
        /// Only update when the new score is less than the current one.
        lt,
    }

    /// Removes the members with the lowest or highest scores from the first non-empty sorted set,
    /// waiting up to the timeout for one, returning its key and the members and their scores.
    ///
    /// Returns none when the timeout passed. A timeout of zero waits indefinitely.
    ///
    /// The connection waits too, replies to commands sent after it on the connection wait behind
    /// it. Use a connection of your own.
    ///
    /// BZMPOP timeout numkeys key [ key ... ] 〈 MIN | MAX 〉 [ COUNT count ]
    /// https://valkey.io/commands/bzmpop/
    bzmpop: async func(connection: borrow<connection>, timeout: duration-milliseconds, keys: list<string>, end: pop-end, count: option<integer>) -> result<option<tuple<string, list<tuple<string, double>>>>, error>;

    /// Removes the member with the highest score from the first non-empty sorted set, waiting up to
    /// the timeout for one, returning its key, the member and its score.
    ///
    /// Returns none when the timeout passed. A timeout of zero waits indefinitely.
    ///
    /// The connection waits too, replies to commands sent after it on the connection wait behind
    /// it. Use a connection of your own.
    ///
    /// BZPOPMAX key [ key ... ] timeout
    /// https://valkey.io/commands/bzpopmax/
    bzpopmax: async func(connection: borrow<connection>, keys: list<string>, timeout: duration-milliseconds) -> result<option<tuple<string, string, double>>, error>;

    /// Removes the member with the lowest score from the first non-empty sorted set, waiting up to
    /// the timeout for one, returning its key, the member and its score.
    ///
    /// Returns none when the timeout passed. A timeout of zero waits indefinitely.
    ///
    /// The connection waits too, replies to commands sent after it on the connection wait behind
    /// it. Use a connection of your own.
    ///
    /// BZPOPMIN key [ key ... ] timeout
    /// https://valkey.io/commands/bzpopmin/
    bzpopmin: async func(connection: borrow<connection>, keys: list<string>, timeout: duration-milliseconds) -> result<option<tuple<string, string, double>>, error>;

    /// Adds the members with their scores to the sorted set stored at key, or updates their scores,
    /// returning how many were added, or with `changed`, added or updated.
    ///
    /// See also `zadd-incr`.
    ///
    /// ZADD key [ NX | XX ] [ GT | LT ] [ CH ] score member [ score member ... ]
    /// https://valkey.io/commands/zadd/
    zadd: async func(connection: borrow<connection>, key: string, condition: option<zadd-condition>, comparison: option<zadd-comparison>, changed: bool, score-and-members: list<tuple<double, string>>) -> result<option<integer>, error>;

    /// Increments the score of the member in the sorted set stored at key, returning the new score,
    /// none when the condition or comparison prevented it.
    ///
    /// See also `zadd` and `zincrby`.
    ///
    /// ZADD key [ NX | XX ] [ GT | LT ] INCR score member
    /// https://valkey.io/commands/zadd/
    zadd-incr: async func(connection: borrow<connection>, key: string, condition: option<zadd-condition>, comparison: option<zadd-comparison>, increment: double, member: string) -> result<option<double>, error>;

    /// The number of members in the sorted set stored at key.
    ///
    /// ZCARD key
    /// https://valkey.io/commands/zcard/
    zcard: async func(connection: borrow<connection>, key: string) -> result<integer, error>;

    /// The number of members of the sorted set stored at key with scores in the range.
    ///
    /// ZCOUNT key min max
    /// https://valkey.io/commands/zcount/
    zcount: async func(connection: borrow<connection>, key: string, min: score-bound, max: score-bound) -> result<integer, error>;

    /// The members of the first sorted set that are not in any of the others.
    ///
    /// See also `zdiff-withscores`.
    ///
    /// ZDIFF numkeys key [ key ... ]
    /// https://valkey.io/commands/zdiff/
    zdiff: async func(connection: borrow<connection>, keys: list<string>) -> result<list<string>, error>;

    /// The members, and their scores, of the first sorted set that are not in any of the others.
    ///
    /// See also `zdiff`.
    ///
    /// ZDIFF numkeys key [ key ... ] WITHSCORES
    /// https://valkey.io/commands/zdiff/
    zdiff-withscores: async func(connection: borrow<connection>, keys: list<string>) -> result<list<tuple<string, double>>, error>;

    /// Stores the members of the first sorted set that are not in any of the others, returning how
    /// many.
    ///
    /// ZDIFFSTORE destination numkeys key [ key ... ]
    /// https://valkey.io/commands/zdiffstore/
    zdiffstore: async func(connection: borrow<connection>, destination: string, keys: list<string>) -> result<integer, error>;

    /// Increments the score of the member in the sorted set stored at key, returning the new score.
    ///
    /// ZINCRBY key increment member
    /// https://valkey.io/commands/zincrby/
    zincrby: async func(connection: borrow<connection>, key: string, increment: double, member: string) -> result<double, error>;

    /// The members in all of the sorted sets.
    ///
    /// The weights, when given, multiply the scores of each sorted set, one for each key.
    ///
    /// See also `zinter-withscores`.
    ///
    /// ZINTER numkeys key [ key ... ] [ WEIGHTS weight [ weight ... ] ] [ AGGREGATE SUM | MIN | MAX ]
    /// https://valkey.io/commands/zinter/
    zinter: async func(connection: borrow<connection>, keys: list<string>, weights: option<list<double>>, aggregate: option<aggregate>) -> result<list<string>, error>;

    /// The members, and their combined scores, in all of the sorted sets.
    ///
    /// See also `zinter`.
    ///
    /// ZINTER numkeys key [ key ... ] [ WEIGHTS weight [ weight ... ] ] [ AGGREGATE SUM | MIN | MAX ] WITHSCORES
    /// https://valkey.io/commands/zinter/
    zinter-withscores: async func(connection: borrow<connection>, keys: list<string>, weights: option<list<double>>, aggregate: option<aggregate>) -> result<list<tuple<string, double>>, error>;

    /// The number of members in all of the sorted sets, counting stops at the limit.
    ///
    /// ZINTERCARD numkeys key [ key ... ] [ LIMIT limit ]
    /// https://valkey.io/commands/zintercard/
    zintercard: async func(connection: borrow<connection>, keys: list<string>, limit: option<integer>) -> result<integer, error>;

    /// Stores the members in all of the sorted sets, with their combined scores, returning how many.
    ///
    /// ZINTERSTORE destination numkeys key [ key ... ] [ WEIGHTS weight [ weight ... ] ] [ AGGREGATE SUM | MIN | MAX ]
    /// https://valkey.io/commands/zinterstore/
    zinterstore: async func(connection: borrow<connection>, destination: string, keys: list<string>, weights: option<list<double>>, aggregate: option<aggregate>) -> result<integer, error>;

    /// The number of members of the sorted set stored at key in the range, for members of equal
    /// score.
    ///
    /// ZLEXCOUNT key min max
    /// https://valkey.io/commands/zlexcount/
    zlexcount: async func(connection: borrow<connection>, key: string, min: lex-bound, max: lex-bound) -> result<integer, error>;

    /// Removes the members with the lowest or highest scores from the first non-empty sorted set,
    /// returning its key and the members and their scores, none when every sorted set is empty.
    ///
    /// ZMPOP numkeys key [ key ... ] 〈 MIN | MAX 〉 [ COUNT count ]
    /// https://valkey.io/commands/zmpop/
    zmpop: async func(connection: borrow<connection>, keys: list<string>, end: pop-end, count: option<integer>) -> result<option<tuple<string, list<tuple<string, double>>>>, error>;

    /// The score of each of the members of the sorted set stored at key, none for a member that is
    /// not in it.
    ///
    /// ZMSCORE key member [ member ... ]
    /// https://valkey.io/commands/zmscore/
    zmscore: async func(connection: borrow<connection>, key: string, members: list<string>) -> result<list<option<double>>, error>;

    /// Removes and returns the members with the highest scores, and their scores, up to the count,
    /// one without a count.
    ///
    /// ZPOPMAX key [ count ]
    /// https://valkey.io/commands/zpopmax/
    zpopmax: async func(connection: borrow<connection>, key: string, count: option<integer>) -> result<list<tuple<string, double>>, error>;

    /// Removes and returns the members with the lowest scores, and their scores, up to the count,
    /// one without a count.
    ///
    /// ZPOPMIN key [ count ]
    /// https://valkey.io/commands/zpopmin/
    zpopmin: async func(connection: borrow<connection>, key: string, count: option<integer>) -> result<list<tuple<string, double>>, error>;

    /// Random members of the sorted set stored at key, up to the count.
    ///
    /// Without a count, one member, or none when the key does not exist. A negative count may return
    /// the same member more than once, its absolute value is the number of members returned.
    ///
    /// See also `zrandmember-withscores`.
    ///
    /// ZRANDMEMBER key [ count ]
    /// https://valkey.io/commands/zrandmember/
    zrandmember: async func(connection: borrow<connection>, key: string, count: option<integer>) -> result<list<string>, error>;

    /// Random members of the sorted set stored at key, and their scores, up to the count.
    ///
    /// A negative count may return the same member more than once, its absolute value is the number
    /// of members returned.
    ///
    /// See also `zrandmember`.
    ///
    /// ZRANDMEMBER key count WITHSCORES
    /// https://valkey.io/commands/zrandmember/
    zrandmember-withscores: async func(connection: borrow<connection>, key: string, count: integer) -> result<list<tuple<string, double>>, error>;

    /// The members of the sorted set stored at key in the range, from the lowest score, or the
    /// highest with `rev`.
    ///
    /// The limit is a range of the members in the range, only with BYSCORE or BYLEX. With `xx`,
    /// returns none when the key does not exist.
    ///
    /// Also covers ZRANGEBYLEX, ZRANGEBYSCORE, ZREVRANGE, ZREVRANGEBYLEX and ZREVRANGEBYSCORE. See
    /// also `zrange-withscores`.
    ///
    /// ZRANGE key start stop [ BYSCORE | BYLEX ] [ REV ] [ LIMIT offset count ] [ XX ]
    /// https://valkey.io/commands/zrange/
    zrange: async func(connection: borrow<connection>, key: string, range: zrange-by, rev: bool, limit: option<limit>, xx: bool) -> result<option<list<string>>, error>;

    /// The members of the sorted set stored at key in the range, and their scores, from the lowest
    /// score, or the highest with `rev`.
    ///
    /// The limit is a range of the members in the range, only with BYSCORE. With `xx`, returns none
    /// when the key does not exist.
    ///
    /// See also `zrange`.
    ///
    /// ZRANGE key start stop [ BYSCORE ] [ REV ] [ LIMIT offset count ] WITHSCORES [ XX ]
    /// https://valkey.io/commands/zrange/
    zrange-withscores: async func(connection: borrow<connection>, key: string, range: zrange-withscores-by, rev: bool, limit: option<limit>, xx: bool) -> result<option<list<tuple<string, double>>>, error>;

    /// Stores the members of the sorted set stored at source in the range, returning how many.
    ///
    /// The limit is a range of the members in the range, only with BYSCORE or BYLEX.
    ///
    /// ZRANGESTORE dst src min max [ BYSCORE | BYLEX ] [ REV ] [ LIMIT offset count ]
    /// https://valkey.io/commands/zrangestore/
    zrangestore: async func(connection: borrow<connection>, destination: string, source: string, range: zrange-by, rev: bool, limit: option<limit>) -> result<integer, error>;

    /// The position of the member in the sorted set stored at key, from the lowest score, none when
    /// it is not a member.
    ///
    /// See also `zrank-withscore` and `zrevrank`.
    ///
    /// ZRANK key member
    /// https://valkey.io/commands/zrank/
    zrank: async func(connection: borrow<connection>, key: string, member: string) -> result<option<integer>, error>;

    /// The position, and the score, of the member in the sorted set stored at key, from the lowest
    /// score, none when it is not a member.
    ///
    /// See also `zrank`.
    ///
    /// ZRANK key member WITHSCORE
    /// https://valkey.io/commands/zrank/
    zrank-withscore: async func(connection: borrow<connection>, key: string, member: string) -> result<option<tuple<integer, double>>, error>;

    /// Removes the members from the sorted set stored at key, returning how many were members.
    ///
    /// ZREM key member [ member ... ]
    /// https://valkey.io/commands/zrem/
    zrem: async func(connection: borrow<connection>, key: string, members: list<string>) -> result<integer, error>;

    /// Removes the members of the sorted set stored at key in the range, for members of equal score,
    /// returning how many.
    ///
    /// ZREMRANGEBYLEX key min max
    /// https://valkey.io/commands/zremrangebylex/
    zremrangebylex: async func(connection: borrow<connection>, key: string, min: lex-bound, max: lex-bound) -> result<integer, error>;

    /// Removes the members of the sorted set stored at key at the positions, both included,
    /// negative from the end, returning how many.
    ///
    /// ZREMRANGEBYRANK key start stop
    /// https://valkey.io/commands/zremrangebyrank/
    zremrangebyrank: async func(connection: borrow<connection>, key: string, start: integer, stop: integer) -> result<integer, error>;

    /// Removes the members of the sorted set stored at key with scores in the range, returning how
    /// many.
    ///
    /// ZREMRANGEBYSCORE key min max
    /// https://valkey.io/commands/zremrangebyscore/
    zremrangebyscore: async func(connection: borrow<connection>, key: string, min: score-bound, max: score-bound) -> result<integer, error>;

    /// The position of the member in the sorted set stored at key, from the highest score, none
    /// when it is not a member.
    ///
    /// See also `zrevrank-withscore`.
    ///
    /// ZREVRANK key member
    /// https://valkey.io/commands/zrevrank/
    zrevrank: async func(connection: borrow<connection>, key: string, member: string) -> result<option<integer>, error>;

    /// The position, and the score, of the member in the sorted set stored at key, from the highest
    /// score, none when it is not a member.
    ///
    /// See also `zrevrank`.
    ///
    /// ZREVRANK key member WITHSCORE
    /// https://valkey.io/commands/zrevrank/
    zrevrank-withscore: async func(connection: borrow<connection>, key: string, member: string) -> result<option<tuple<integer, double>>, error>;

    /// Incrementally iterate over the members of the sorted set stored at key, and their scores.
    ///
    /// See also `zscan-noscores`.
    ///
    /// ZSCAN key cursor [ MATCH pattern ] [ COUNT count ]
    /// https://valkey.io/commands/zscan/
    zscan: async func(connection: borrow<connection>, key: string, cursor: cursor, match: option<string>, count: option<integer>) -> result<tuple<option<cursor>, list<tuple<string, double>>>, error>;

    /// Incrementally iterate over the members of the sorted set stored at key.
    ///
    /// See also `zscan`.
    ///
    /// ZSCAN key cursor [ MATCH pattern ] [ COUNT count ] NOSCORES
    /// https://valkey.io/commands/zscan/
    zscan-noscores: async func(connection: borrow<connection>, key: string, cursor: cursor, match: option<string>, count: option<integer>) -> result<tuple<option<cursor>, list<string>>, error>;

    /// The score of the member in the sorted set stored at key, none when it is not a member.
    ///
    /// ZSCORE key member
    /// https://valkey.io/commands/zscore/
    zscore: async func(connection: borrow<connection>, key: string, member: string) -> result<option<double>, error>;

    /// The members in any of the sorted sets.
    ///
    /// The weights, when given, multiply the scores of each sorted set, one for each key.
    ///
    /// See also `zunion-withscores`.
    ///
    /// ZUNION numkeys key [ key ... ] [ WEIGHTS weight [ weight ... ] ] [ AGGREGATE SUM | MIN | MAX ]
    /// https://valkey.io/commands/zunion/
    zunion: async func(connection: borrow<connection>, keys: list<string>, weights: option<list<double>>, aggregate: option<aggregate>) -> result<list<string>, error>;

    /// The members, and their combined scores, in any of the sorted sets.
    ///
    /// See also `zunion`.
    ///
    /// ZUNION numkeys key [ key ... ] [ WEIGHTS weight [ weight ... ] ] [ AGGREGATE SUM | MIN | MAX ] WITHSCORES
    /// https://valkey.io/commands/zunion/
    zunion-withscores: async func(connection: borrow<connection>, keys: list<string>, weights: option<list<double>>, aggregate: option<aggregate>) -> result<list<tuple<string, double>>, error>;

    /// Stores the members in any of the sorted sets, with their combined scores, returning how many.
    ///
    /// ZUNIONSTORE destination numkeys key [ key ... ] [ WEIGHTS weight [ weight ... ] ] [ AGGREGATE SUM | MIN | MAX ]
    /// https://valkey.io/commands/zunionstore/
    zunionstore: async func(connection: borrow<connection>, destination: string, keys: list<string>, weights: option<list<double>>, aggregate: option<aggregate>) -> result<integer, error>;


    // stream commands

    /// The ID of a stream entry, `<milliseconds-time>-<sequence-number>`, e.g. `1526919030474-55`.
    ///
    /// Commands that add an entry also accept `*`, for the server to generate the ID.
    type stream-id = string;

    /// How a stream is trimmed, e.g. with XADD or XTRIM.
    variant stream-trim {
        /// Evicts entries as long as the stream's length exceeds the specified threshold, where threshold is a positive integer.
        maxlen(stream-trim-maxlen),
        /// Evicts entries with IDs lower than threshold, where threshold is a stream ID.
        minid(stream-trim-minid),
    }

    /// Trims the stream to a maximum length, `MAXLEN [ = | ~ ] threshold [ LIMIT count ]`.
    record stream-trim-maxlen {
        /// Exact, `=`, when none.
        efficiency: option<stream-trim-efficiency>,
        /// The maximum number of entries kept.
        threshold: integer,
        /// The maximum number of entries evicted, only with nearly exact trimming, `0` for no limit.
        limit: option<integer>,
    }

    /// Trims the entries with lower IDs, `MINID [ = | ~ ] threshold [ LIMIT count ]`.
    record stream-trim-minid {
        /// Exact, `=`, when none.
        efficiency: option<stream-trim-efficiency>,
        /// The lowest ID kept.
        threshold: stream-id,
        /// The maximum number of entries evicted, only with nearly exact trimming, `0` for no limit.
        limit: option<integer>,
    }

    /// How exactly a stream is trimmed. Nearly exact trimming is more efficient, the stream may keep a
    /// few entries more than the threshold.
    enum stream-trim-efficiency {
        /// `=`: exact trimming
        exact,
        /// `~`: nearly exact trimming
        mearly-exact,
    }

    /// Removes one or multiple messages from the Pending Entries List (PEL) of a stream consumer group.
    ///
    /// XACK key group ID [ ID ... ]
    /// https://valkey.io/commands/xack/
    xack: async func(connection: borrow<connection>, key: string, group: string, ids: list<stream-id>) -> result<integer, error>;

    /// Appends the specified stream entry to the stream at the specified key.
    ///
    /// XADD key [ NOMKSTREAM ] [ 〈 MAXLEN | MINID 〉 [ = | ~ ] threshold [ LIMIT count ] ] 〈 * | id 〉 field value [ field value ... ]
    /// https://valkey.io/commands/xadd/
    xadd: async func(connection: borrow<connection>, key: string, nomkstream: bool, trim: option<stream-trim>, id: stream-id, field-and-values: list<tuple<string, string>>) -> result<option<stream-id>, error>;

    /// Transfers ownership of pending stream entries that match the specified criteria.
    ///
    /// See also `xautoclaim-justid`
    ///
    /// A start of none scans from the beginning, `0-0`. The next start is returned, none once the scan
    /// is complete, along with the IDs of claimed entries that no longer exist, which are removed
    /// from the pending entries list.
    ///
    /// XAUTOCLAIM key group consumer min-idle-time start [ COUNT count ]
    /// https://valkey.io/commands/xautoclaim/
    xautoclaim: async func(connection: borrow<connection>, key: string, group: string, consumer: string, min-idle-time: duration-milliseconds, start: option<stream-id>, count: option<integer>) -> result<tuple<option<stream-id>, list<tuple<stream-id, map<string, string>>>, list<stream-id>>, error>;

    /// Transfers ownership of pending stream entries that match the specified criteria.
    ///
    /// See also `xautoclaim`
    ///
    /// A start of none scans from the beginning, `0-0`. The next start is returned, none once the scan
    /// is complete, along with the IDs of claimed entries that no longer exist, which are removed
    /// from the pending entries list.
    ///
    /// XAUTOCLAIM key group consumer min-idle-time start [ COUNT count ] JUSTID
    /// https://valkey.io/commands/xautoclaim/
    xautoclaim-justid: async func(connection: borrow<connection>, key: string, group: string, consumer: string, min-idle-time: duration-milliseconds, start: option<stream-id>, count: option<integer>) -> result<tuple<option<stream-id>, list<stream-id>, list<stream-id>>, error>;


    /// Options of XCLAIM.
    record xclaim-opts {
        /// `IDLE ms`: sets the idle time of the entries, the time since they were last delivered, instead
        /// of resetting it.
        idle: option<duration-milliseconds>,
        /// `TIME unix-time-milliseconds`: sets the idle time of the entries to the time since this instant.
        time: option<unix-time-milliseconds>,
        /// `RETRYCOUNT count`: sets the delivery count of the entries, instead of incrementing it.
        retrycount: option<integer>,
        /// `FORCE`: claims the entries even when they are not pending for any consumer, as long as they
        /// exist in the stream.
        force: bool,
        /// `LASTID lastid`: sets the ID of the last entry delivered to the group.
        lastid: option<stream-id>,
    }

    /// Changes the ownership of a pending message, so that the new owner is the consumer specified as the command argument.
    ///
    /// Also see `xclaim-justid`
    ///
    /// XCLAIM key group consumer min-idle-time ID [ ID ... ] [ IDLE ms ] [ TIME unix-time-milliseconds ] [ RETRYCOUNT count ] [ FORCE ] [ LASTID lastid ]
    /// https://valkey.io/commands/xclaim/
    xclaim: async func(connection: borrow<connection>, key: string, group: string, consumer: string, min-idle-time: duration-milliseconds, ids: list<stream-id>, opts: option<xclaim-opts>) -> result<list<tuple<stream-id, map<string, string>>>, error>;

    /// Changes the ownership of a pending message, so that the new owner is the consumer specified as the command argument.
    ///
    /// Also see `xclaim`
    ///
    /// XCLAIM key group consumer min-idle-time ID [ ID ... ] [ IDLE ms ] [ TIME unix-time-milliseconds ] [ RETRYCOUNT count ] [ FORCE ] JUSTID [ LASTID lastid ]
    /// https://valkey.io/commands/xclaim/
    xclaim-justid: async func(connection: borrow<connection>, key: string, group: string, consumer: string, min-idle-time: duration-milliseconds, ids: list<stream-id>, opts: option<xclaim-opts>) -> result<list<stream-id>, error>;

    /// Removes the specified entries from a stream, and returns the number of entries deleted.
    ///
    /// XDEL key ID [ ID ... ]
    /// https://valkey.io/commands/xdel/
    xdel: async func(connection: borrow<connection>, key: string, ids: list<stream-id>) -> result<integer, error>;

    /// Create a new consumer group uniquely identified by <groupname> for the stream stored at <key>.
    ///
    /// XGROUP CREATE key group 〈 id | $ 〉 [ MKSTREAM ] [ ENTRIESREAD entriesread ]
    /// https://valkey.io/commands/xgroup-create/
    xgroup-create: async func(connection: borrow<connection>, key: string, group: string, id: stream-id, mkstream: bool, entriesread: option<integer>) -> result<_, error>;

    /// Create a consumer named <consumername> in the consumer group <groupname> of the stream that's stored at <key>.
    ///
    /// XGROUP CREATECONSUMER key group consumer
    /// https://valkey.io/commands/xgroup-createconsumer/
    xgroup-createconsumer: async func(connection: borrow<connection>, key: string, group: string, consumer: string) -> result<bool, error>;

    /// The XGROUP DELCONSUMER command deletes a consumer from the consumer group.
    ///
    /// XGROUP DELCONSUMER key group consumer
    /// https://valkey.io/commands/xgroup-delconsumer/
    xgroup-delconsumer: async func(connection: borrow<connection>, key: string, group: string, consumer: string) -> result<integer, error>;

    /// Completely destroys the consumer group.
    ///
    /// XGROUP DESTROY key group
    /// https://valkey.io/commands/xgroup-destroy/
    xgroup-destroy: async func(connection: borrow<connection>, key: string, group: string) -> result<bool, error>;

    /// Set the last delivered ID for a consumer group.
    ///
    /// XGROUP SETID key group 〈 id | $ 〉 [ ENTRIESREAD entriesread ]
    /// https://valkey.io/commands/xgroup-setid/
    xgroup-setid: async func(connection: borrow<connection>, key: string, group: string, id: stream-id, entriesread: option<integer>) -> result<_, error>;

    /// A consumer of a group, see `xinfo-consumers`.
    record xinfo-consumer {
        /// The consumer's name.
        name: string,
        /// The number of entries pending for the consumer.
        pending: integer,
        /// The time since the consumer last attempted an interaction, e.g. XREADGROUP, XCLAIM or
        /// XAUTOCLAIM.
        idle: duration-milliseconds,
        /// The time since the consumer last interacted successfully, e.g. read or claimed entries.
        /// None when the consumer has never been active.
        inactive: option<duration-milliseconds>,
    }

    /// Consumers that belong to the <groupname> consumer group of the stream stored at <key>.
    ///
    /// XINFO CONSUMERS key group
    /// https://valkey.io/commands/xinfo-consumers/
    xinfo-consumers: async func(connection: borrow<connection>, key: string, group: string) -> result<list<xinfo-consumer>, error>;

    /// A consumer group of a stream, see `xinfo-groups`.
    record xinfo-group {
        /// The group's name.
        name: string,
        /// The number of consumers in the group.
        consumers: integer,
        /// The number of entries in the group's pending entries list (PEL), delivered but not acknowledged.
        pending: integer,
        /// The ID of the last entry delivered to the group's consumers.
        last-delivered-id: stream-id,
        /// The logical read counter of the last entry delivered to the group's consumers, none when unknown.
        entries-read: option<integer>,
        /// The number of entries in the stream not yet delivered to the group's consumers, none when it
        /// cannot be determined.
        lag: option<integer>,
    }

    /// Consumer groups of the stream stored at <key>.
    ///
    /// XINFO GROUPS key
    /// https://valkey.io/commands/xinfo-groups/
    xinfo-groups: async func(connection: borrow<connection>, key: string) -> result<list<xinfo-group>, error>;

    /// Information about a stream, see `xinfo-stream`.
    record xinfo-stream-reply {
        /// The number of entries in the stream.
        length: integer,
        /// The number of keys in the radix tree storing the stream.
        radix-tree-keys: integer,
        /// The number of nodes in the radix tree storing the stream.
        radix-tree-nodes: integer,
        /// The number of consumer groups of the stream.
        groups: integer,
        /// The ID of the last entry added to the stream, none when no entry was ever added.
        last-generated-id: option<stream-id>,
        /// The highest ID deleted from the stream, none when no entry was ever deleted.
        max-deleted-entry-id: option<stream-id>,
        /// The number of entries added to the stream over its lifetime.
        entries-added: integer,
        /// The ID and fields of the first entry.
        /// None when the stream is empty.
        first-entry: option<tuple<stream-id, map<string, string>>>,
        /// The ID and fields of the last entry.
        /// None when the stream is empty.
        last-entry: option<tuple<stream-id, map<string, string>>>,
    }

    /// Information about the stream stored at <key>.
    ///
    /// See also `xinfo-stream-full`
    ///
    /// XINFO STREAM key
    /// https://valkey.io/commands/xinfo-stream/
    xinfo-stream: async func(connection: borrow<connection>, key: string) -> result<xinfo-stream-reply, error>;

    /// Information about a stream, its entries and consumer groups, see `xinfo-stream-full`.
    record xinfo-stream-reply-full {
        /// The number of entries in the stream.
        length: integer,
        /// The number of keys in the radix tree storing the stream.
        radix-tree-keys: integer,
        /// The number of nodes in the radix tree storing the stream.
        radix-tree-nodes: integer,
        /// The ID of the last entry added to the stream, none when no entry was ever added.
        last-generated-id: option<stream-id>,
        /// The highest ID deleted from the stream, none when no entry was ever deleted.
        max-deleted-entry-id: option<stream-id>,
        /// The number of entries added to the stream over its lifetime.
        entries-added: integer,
        /// The ID and fields of the entries, in ascending ID order, up to the count given.
        entries: list<tuple<stream-id, map<string, string>>>,
        /// The consumer groups of the stream.
        groups: list<xinfo-stream-reply-full-group>,
    }

    /// A consumer group of a stream, with its pending entries and consumers.
    record xinfo-stream-reply-full-group {
        /// The group's name.
        name: string,
        /// The ID of the last entry delivered to the group's consumers.
        last-delivered-id: stream-id,
        /// The logical read counter of the last entry delivered to the group's consumers, none when unknown.
        entries-read: option<integer>,
        /// The number of entries in the stream not yet delivered to the group's consumers, none when it
        /// cannot be determined.
        lag: option<integer>,
        /// The number of entries in the group's pending entries list (PEL), delivered but not acknowledged.
        pel-count: integer,
        /// The group's pending entries, the ID of each, the consumer it was delivered to, when it was
        /// last delivered and the number of times it was delivered.
        pending: list<tuple<stream-id, string, unix-time-milliseconds, integer>>,
        /// The group's consumers.
        consumers: list<xinfo-stream-reply-full-consumer>,
    }

    /// A consumer of a group, with its pending entries.
    record xinfo-stream-reply-full-consumer {
        /// The consumer's name.
        name: string,
        /// When the consumer last attempted an interaction, e.g. XREADGROUP, XCLAIM or XAUTOCLAIM.
        seen-time: unix-time-milliseconds,
        /// When the consumer last interacted successfully, e.g. read or claimed entries.
        /// None when the consumer has never been active.
        active-time: option<unix-time-milliseconds>,
        /// The number of entries pending for the consumer, delivered but not acknowledged.
        pel-count: integer,
        /// The consumer's pending entries, the ID of each, when it was last delivered and the number of
        /// times it was delivered.
        pending: list<tuple<stream-id, unix-time-milliseconds, integer>>,
    }

    /// Information about the stream stored at <key>.
    ///
    /// See also `xinfo-stream`
    ///
    /// XINFO STREAM key FULL [ COUNT count ]
    /// https://valkey.io/commands/xinfo-stream/
    xinfo-stream-full: async func(connection: borrow<connection>, key: string, count: option<integer>) -> result<xinfo-stream-reply-full, error>;

    /// Number of entries inside a stream.
    ///
    /// XLEN key
    /// https://valkey.io/commands/xlen/
    xlen: async func(connection: borrow<connection>, key: string) -> result<integer, error>;

    /// The pending entries of a consumer group, see `xpending`.
    record xpending-summary {
        /// The number of pending entries.
        count: integer,
        /// The lowest ID of the pending entries, none when there are none.
        lowest-id: option<stream-id>,
        /// The highest ID of the pending entries, none when there are none.
        highest-id: option<stream-id>,
        /// Each consumer with pending entries, and how many it has.
        consumers: list<tuple<string, integer>>,
    }

    /// List of pending messages.
    ///
    /// See also `xpending-extended`.
    ///
    /// XPENDING key group
    /// https://valkey.io/commands/xpending/
    xpending: async func(connection: borrow<connection>, key: string, group: string) -> result<xpending-summary, error>;

    /// The pending entries of a consumer group, see `xpending-extended`.
    record xpending-extended-entry {
        /// The ID of the message.
        id: stream-id,
        /// The name of the consumer that fetched the message and has still to acknowledge it. We call it the current owner of the message.
        name: string,
        /// The number of milliseconds that elapsed since the last time this message was delivered to this consumer.
        since-delivery: duration-milliseconds,
        /// The number of times this message was delivered.
        delivery-count: integer,
    }

    /// List of pending messages.
    ///
    /// See also `xpending`.
    ///
    /// XPENDING key group [ IDLE min-idle-time ] start end count [ consumer ]
    /// https://valkey.io/commands/xpending/
    xpending-extended: async func(connection: borrow<connection>, key: string, group: string, min-idle-time: option<duration-milliseconds>, start: stream-id, end: stream-id, count: integer, consumer: option<string>) -> result<list<xpending-extended-entry>, error>;

    /// Stream entries matching a given range of IDs.
    ///
    /// XRANGE key start end [ COUNT count ]
    /// https://valkey.io/commands/xrange/
    xrange: async func(connection: borrow<connection>, key: string, start: stream-id, end: stream-id, count: option<integer>) -> result<list<tuple<stream-id, map<string, string>>>, error>;

    /// Read data from one or multiple streams, only returning entries with an ID greater than the last received ID reported by the caller.
    ///
    /// XREAD [ COUNT count ] [ BLOCK milliseconds ] STREAMS key [ key ... ] ID [ ID ... ]
    /// https://valkey.io/commands/xread/
    xread: async func(connection: borrow<connection>, count: option<integer>, block: option<duration-milliseconds>, keys: list<string>, ids: list<stream-id>) -> result<option<map<string, list<tuple<stream-id, map<string, string>>>>>, error>;

    /// Special version of the XREAD command with support for consumer groups.
    ///
    /// The fields of an entry are none when it was deleted after it was delivered, e.g. when reading
    /// the pending entries with the ID `0`.
    ///
    /// XREADGROUP GROUP group consumer [ COUNT count ] [ BLOCK milliseconds ] [ NOACK ] STREAMS key [ key ... ] ID [ ID ... ]
    /// https://valkey.io/commands/xreadgroup/
    xreadgroup: async func(connection: borrow<connection>, group: string, consumer: string, count: option<integer>, block: option<duration-milliseconds>, noack: bool, keys: list<string>, ids: list<stream-id>) -> result<option<map<string, list<tuple<stream-id, option<map<string, string>>>>>>, error>;

    /// XRANGE, but returning the entries in reverse order.
    ///
    /// XREVRANGE key end start [ COUNT count ]
    /// https://valkey.io/commands/xrevrange/
    xrevrange: async func(connection: borrow<connection>, key: string, end: stream-id, start: stream-id, count: option<integer>) -> result<list<tuple<stream-id, map<string, string>>>, error>;

    /// Internal command. It is used by a Valkey primary to replicate the last delivered ID of streams.
    ///
    /// XSETID key last-id [ ENTRIESADDED entries-added ] [ MAXDELETEDID max-deleted-id ]
    /// https://valkey.io/commands/xsetid/
    xsetid: async func(connection: borrow<connection>, key: string, last-id: stream-id, entries-added: option<integer>, max-deleted-id: option<stream-id>) -> result<_, error>;

    /// Trims the stream by evicting older entries.
    ///
    /// XTRIM key 〈 MAXLEN | MINID 〉 [ = | ~ ] threshold [ LIMIT count ]
    /// https://valkey.io/commands/xtrim/
    xtrim: async func(connection: borrow<connection>, key: string, trim: stream-trim) -> result<integer, error>;


    // string commands


    /// Appends the value at the end of the string.
    ///
    /// APPEND key value
    /// https://valkey.io/commands/append/
    append: async func(connection: borrow<connection>, key: string, value: string) -> result<integer, error>;

    /// Decrements the number stored at key by one.
    ///
    /// DECR key
    /// https://valkey.io/commands/decr/
    decr: async func(connection: borrow<connection>, key: string) -> result<integer, error>;

    /// Decrements the number stored at key by decrement.
    ///
    /// DECRBY key decrement
    /// https://valkey.io/commands/decrby/
    decrby: async func(connection: borrow<connection>, key: string, decrement: integer) -> result<integer, error>;

    /// Deletes the key if its value matches the given string.
    ///
    /// DELIFEQ key value
    /// https://valkey.io/commands/delifeq/
    delifeq: async func(connection: borrow<connection>, key: string, value: string) -> result<bool, error>;


    /// Get the value of key.
    ///
    /// GET key
    /// https://valkey.io/commands/get/
    get: async func(connection: borrow<connection>, key: string) -> result<option<string>, error>;

    /// Get the value of key and delete the key.
    ///
    /// GETDEL key
    /// https://valkey.io/commands/getdel/
    getdel: async func(connection: borrow<connection>, key: string) -> result<option<string>, error>;

    /// The expiration to set on a key, see `getex`.
    variant getex-ttl {
        /// Set the specified expire time, in seconds.
        ex(duration-seconds),
        /// Set the specified expire time, in milliseconds.
        px(duration-milliseconds),
        /// Set the specified Unix time at which the key will expire, in seconds.
        exat(unix-time-seconds),
        /// Set the specified Unix time at which the key will expire, in milliseconds.
        pxat(unix-time-milliseconds),
        /// Remove the time to live associated with the key.
        persist,
    }

    /// Get the value of key and optionally set its expiration.
    ///
    /// GETEX key [ EX seconds | PX milliseconds | EXAT unix-time-seconds | PXAT unix-time-milliseconds | PERSIST ]
    /// https://valkey.io/commands/getex/
    getex: async func(connection: borrow<connection>, key: string, ttl: option<getex-ttl>) -> result<option<string>, error>;

    /// Returns the substring of the string value stored at key, determined by the offsets start and end.
    ///
    /// GETRANGE key start end
    /// https://valkey.io/commands/getrange/
    getrange: async func(connection: borrow<connection>, key: string, start: integer, end: integer) -> result<string, error>;

    /// Atomically sets key to value and returns the old value stored at key.
    ///
    /// GETSET key value
    /// https://valkey.io/commands/getset/
    getset: async func(connection: borrow<connection>, key: string, value: string) -> result<option<string>, error>;

    /// Increments the number stored at key by one.
    ///
    /// INCR key
    /// https://valkey.io/commands/incr/
    incr: async func(connection: borrow<connection>, key: string) -> result<integer, error>;

    /// Increments the number stored at key by increment.
    ///
    /// INCRBY key increment
    /// https://valkey.io/commands/incrby/
    incrby: async func(connection: borrow<connection>, key: string, increment: integer) -> result<integer, error>;

    /// Increment the string representing a floating point number stored at key by the specified increment.
    ///
    /// INCRBYFLOAT key increment
    /// https://valkey.io/commands/incrbyfloat/
    incrbyfloat: async func(connection: borrow<connection>, key: string, increment: double) -> result<double, error>;

    /// The LCS command implements the longest common subsequence algorithm.
    ///
    /// See also `lcs-len` and `lcs-idx`
    ///
    /// LCS key1 key2
    /// https://valkey.io/commands/lcs/
    lcs: async func(connection: borrow<connection>, key1: string, key2: string) -> result<string, error>;

    /// The LCS command implements the longest common subsequence algorithm.
    ///
    /// See also `lcs` and `lcs-idx`
    ///
    /// LCS key1 key2 LEN
    /// https://valkey.io/commands/lcs/
    lcs-len: async func(connection: borrow<connection>, key1: string, key2: string) -> result<integer, error>;

    /// The longest common subsequence of two strings, as the ranges matching in each, see `lcs-idx`.
    record lcs-idx-reply {
        /// The ranges that match, from the end of the strings to their start.
        matches: list<lcs-idx-match>,
        /// The length of the longest common subsequence.
        len: integer,
    }

    /// A part of the longest common subsequence.
    record lcs-idx-match {
        /// The inclusive start and end positions of the match in the first key's string.
        key1-range: tuple<integer, integer>,
        /// The inclusive start and end positions of the match in the second key's string.
        key2-range: tuple<integer, integer>,
        /// The length of the match, with `with-match-len`.
        len: option<integer>,
    }

    /// The LCS command implements the longest common subsequence algorithm.
    ///
    /// See also `lcs` and `lcs-len`
    ///
    /// LCS key1 key2 IDX [ MINMATCHLEN min-match-len ] [ WITHMATCHLEN ]
    /// https://valkey.io/commands/lcs/
    lcs-idx: async func(connection: borrow<connection>, key1: string, key2: string, min-match-len: option<integer>, with-match-len: bool ) -> result<lcs-idx-reply, error>;

    /// Returns the values of all specified keys.
    ///
    /// MGET key [ key ... ]
    /// https://valkey.io/commands/mget/
    mget: async func(connection: borrow<connection>, keys: list<string>) -> result<list<option<string>>, error>;

    /// Sets the given keys to their respective values.
    ///
    /// MSET key value [ key value ... ]
    /// https://valkey.io/commands/mset/
    mset: async func(connection: borrow<connection>, keys-and-values: list<tuple<string, string>>) -> result<_, error>;

    /// The condition for setting the keys, see `msetex`.
    variant msetex-precondition {
        /// Only set the keys if all of them do not already exist.
        nx,
        /// Only set the keys if all of them already exist.
        xx,
    }

    /// The expiration to set on the keys, see `msetex`.
    type msetex-ttl = set-ttl;

    /// Sets multiple key-value pairs while also assigning a shared expiration time to all the keys atomically.
    ///
    /// MSETEX numkeys key value [ key value ... ] [ NX | XX ] [ EX seconds | PX milliseconds | EXAT unix-time-seconds | PXAT unix-time-milliseconds | KEEPTTL ]
    /// https://valkey.io/commands/msetex/
    msetex: async func(connection: borrow<connection>, keys-and-values: list<tuple<string, string>>, precondition: option<msetex-precondition>, ttl: option<msetex-ttl>) -> result<bool, error>;

    /// Sets the given keys to their respective values.
    ///
    /// MSETNX key value [ key value ... ]
    /// https://valkey.io/commands/msetnx/
    msetnx: async func(connection: borrow<connection>, keys-and-values: list<tuple<string, string>>) -> result<bool, error>;

    /// Set key to hold the string value with expiration in milliseconds.
    ///
    /// PSETEX key milliseconds value
    /// https://valkey.io/commands/psetex/
    psetex: async func(connection: borrow<connection>, key: string, milliseconds: duration-milliseconds, value: string) -> result<_, error>;

    /// The condition for setting a key, see `set`.
    variant set-precondition {
        /// Only set the key if it does not already exist.
        nx,
        /// Only set the key if it already exists.
        xx,
        /// Set the key if the comparison value matches the existing value.
        ifeq(string),
        /// Set the key if the comparison value does not match the existing value.
        ifne(string),
    }

    /// The expiration to set on a key, see `set`.
    variant set-ttl {
        /// Set the specified expire time, in seconds.
        ex(duration-seconds),
        /// Set the specified expire time, in milliseconds.
        px(duration-milliseconds),
        /// Set the specified Unix time at which the key will expire, in seconds.
        exat(unix-time-seconds),
        /// Set the specified Unix time at which the key will expire, in milliseconds.
        pxat(unix-time-milliseconds),
        /// Retain the time to live associated with the keys.
        keepttl,
    }

    /// Set key to hold the string value.
    ///
    /// Returns false when the precondition is not met, the key is unchanged.
    ///
    /// SET key value [ NX | XX | IFEQ comparison-value | IFNE comparison-not-equal ] [ EX seconds | PX milliseconds | EXAT unix-time-seconds | PXAT unix-time-milliseconds | KEEPTTL ]
    /// https://valkey.io/commands/set/
    set: async func(connection: borrow<connection>, key: string, value: string, precondition: option<set-precondition>, ttl: option<set-ttl>) -> result<bool, error>;

    /// Set key to hold the string value. Returning the previous value.
    ///
    /// SET key value [ NX | XX | IFEQ comparison-value | IFNE comparison-not-equal ] GET [ EX seconds | PX milliseconds | EXAT unix-time-seconds | PXAT unix-time-milliseconds | KEEPTTL ]
    /// https://valkey.io/commands/set/
    set-get: async func(connection: borrow<connection>, key: string, value: string, precondition: option<set-precondition>, ttl: option<set-ttl>) -> result<option<string>, error>;

    /// Set key to hold the string value with expiration in seconds.
    ///
    /// SETEX key seconds value
    /// https://valkey.io/commands/setex/
    setex: async func(connection: borrow<connection>, key: string, seconds: duration-seconds, value: string) -> result<_, error>;

    /// Set key to hold string value if key does not exist.
    ///
    /// SETNX key value
    /// https://valkey.io/commands/setnx/
    setnx: async func(connection: borrow<connection>, key: string, value: string) -> result<bool, error>;

    /// Overwrites part of the string stored at key, starting at the specified offset, for the entire length of value.
    ///
    /// SETRANGE key offset value
    /// https://valkey.io/commands/setrange/
    setrange: async func(connection: borrow<connection>, key: string, offset: u32, value: string) -> result<integer, error>;

    /// Returns the length of the string value stored at key.
    ///
    /// STRLEN key
    /// hthttps://valkey.io/commands/strlen/
    strlen: async func(connection: borrow<connection>, key: string) -> result<integer, error>;

    /// Returns the substring of the string value stored at key, determined by the offsets start and end.
    ///
    /// SUBSTR key start end
    /// https://valkey.io/commands/substr/
    substr: async func(connection: borrow<connection>, key: string, start: integer, end: integer) -> result<string, error>;

}
