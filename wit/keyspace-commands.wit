/// Commands for keys of any type, Valkey's @keyspace ACL category.
interface keyspace-commands {
    use wasi:clocks/system-clock@0.3.0.{duration, instant};
    use connection.{connection, error};

    enum expire-mode {
        /// Set expiration only when the field has no expiration.
        nx,
        /// Set expiration only when the field has an existing expiration.
        xx,
        /// Set expiration only when the new expiration is greater than current one.
        gt,
        /// Set expiration only when the new expiration is less than current one.
        lt,
    }

    enum expire-result {
        /// -2: key does not exist, or field does not exist in the HASH.
        does-not-exist,
        /// 0: the specified NX | XX | GT | LT condition has not been met.
        condition-not-met,
        /// 1: the expiration time was applied.
        applied,
        /// 2: when called with 0 seconds.
        zero-seconds,
    }

    del: async func(connection: borrow<connection>, key: string) -> result<_, error>;
    exists: async func(connection: borrow<connection>, key: string) -> result<bool, error>;
    expire: async func(connection: borrow<connection>, key: string, seconds: duration, mode: option<expire-mode>) -> result<expire-result, error>;
    expireat: async func(connection: borrow<connection>, key: string, seconds: instant, mode: option<expire-mode>) -> result<expire-result, error>;
    keys: async func(connection: borrow<connection>, pattern: string) -> result<list<string>, error>;

    // not yet implemented, from the @keyspace category:
    //   CLUSTERSCAN
    //   CLUSTER FLUSHSLOT
    //   COPY
    //   DBSIZE
    //   DUMP
    //   EXPIRETIME
    //   FLUSHALL
    //   FLUSHDB
    //   MIGRATE
    //   MOVE
    //   OBJECT ENCODING
    //   OBJECT FREQ
    //   OBJECT IDLETIME
    //   OBJECT REFCOUNT
    //   PERSIST
    //   PEXPIRE
    //   PEXPIREAT
    //   PEXPIRETIME
    //   PTTL
    //   RANDOMKEY
    //   RENAME
    //   RENAMENX
    //   RESTORE
    //   RESTORE-ASKING
    //   SCAN
    //   SWAPDB
    //   TOUCH
    //   TTL
    //   TYPE
    //   UNLINK
}
