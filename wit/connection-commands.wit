/// Commands about the connection, Valkey's @connection ACL category.
///
/// Not to be confused with the `connection` interface, the mechanics of talking to a server.
interface connection-commands {
    use resp.{value};
    use connection.{connection, error};

    /// Options for `hello`, the protocol is always 3.
    record hello-opts {
        auth: option<tuple<string, string>>,
        client-name: option<string>,
    }

    auth: async func(connection: borrow<connection>, username: string, password: string) -> result<_, error>;
    /// Sends `HELLO 3`, with the options' AUTH and SETNAME, and returns the server's properties.
    ///
    /// A connection already sends HELLO when it is established, see `connection.new`, sending it
    /// again is useful e.g. to authenticate as another user.
    hello: async func(connection: borrow<connection>, opts: option<hello-opts>) -> result<list<tuple<string, value>>, error>;
    ping: async func(connection: borrow<connection>) -> result<_, error>;

    // not yet implemented, from the @connection category:
    //   ASKING
    //   CLIENT CACHING
    //   CLIENT CAPA
    //   CLIENT GETNAME
    //   CLIENT GETREDIR
    //   CLIENT ID
    //   CLIENT IMPORT-SOURCE
    //   CLIENT INFO
    //   CLIENT KILL
    //   CLIENT LIST
    //   CLIENT NO-EVICT
    //   CLIENT NO-TOUCH
    //   CLIENT PAUSE
    //   CLIENT REPLY
    //   CLIENT SETINFO
    //   CLIENT SETNAME
    //   CLIENT TRACKING
    //   CLIENT TRACKINGINFO
    //   CLIENT UNBLOCK
    //   CLIENT UNPAUSE
    //   COMMAND
    //   COMMAND COUNT
    //   COMMAND DOCS
    //   COMMAND GETKEYS
    //   COMMAND GETKEYSANDFLAGS
    //   COMMAND INFO
    //   COMMAND LIST
    //   ECHO
    //   QUIT
    //   READONLY
    //   READWRITE
    //   RESET
    //   SELECT
    //   WAIT
    //   WAITAOF
}
