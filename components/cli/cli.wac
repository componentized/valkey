package componentized:valkey;

let resp = new local:resp { ... };
let connection = new local:connection {
    "componentized:valkey/resp@0.3.0-dev": resp.resp,
    ...
};
let tcp = new local:tcp {
    "componentized:valkey/resp@0.3.0-dev": resp.resp,
    "componentized:valkey/connection@0.3.0-dev": connection.connection,
    ...
};
let commands = new local:commands {
    "componentized:valkey/resp@0.3.0-dev": resp.resp,
    "componentized:valkey/connection@0.3.0-dev": connection.connection,
    ...
};
let cli = new local:dep-cli {
    "componentized:valkey/resp@0.3.0-dev": resp.resp,
    "componentized:valkey/connection@0.3.0-dev": connection.connection,
    "componentized:valkey/tcp@0.3.0-dev": tcp.tcp,
    "componentized:valkey/admin-commands@0.3.0-dev": commands["componentized:valkey/admin-commands@0.3.0-dev"],
    "componentized:valkey/connection-commands@0.3.0-dev": commands["componentized:valkey/connection-commands@0.3.0-dev"],
    "componentized:valkey/hash-commands@0.3.0-dev": commands["componentized:valkey/hash-commands@0.3.0-dev"],
    "componentized:valkey/keyspace-commands@0.3.0-dev": commands["componentized:valkey/keyspace-commands@0.3.0-dev"],
    "componentized:valkey/pubsub-commands@0.3.0-dev": commands["componentized:valkey/pubsub-commands@0.3.0-dev"],
    "componentized:valkey/string-commands@0.3.0-dev": commands["componentized:valkey/string-commands@0.3.0-dev"],
    ...
};

export cli...;
